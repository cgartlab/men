{
  "name": "men-site",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/highlight-code.mjs",
    "preview": "astro preview",
    "check-site": "node scripts/check-site.mjs",
    "check-contrast": "node scripts/contrast-check.mjs",
    "check-tokens": "node scripts/token-ratio-check.mjs",
    "check-text-contrast": "node scripts/text-contrast-audit.mjs",
    "check-dynamic-el": "node scripts/dynamic-el-audit.mjs",
    "check-typography": "node scripts/typography-audit.mjs",
    "check-widow": "node scripts/widow-audit.mjs",
    "verify-widow-fix": "node scripts/widow-verify.mjs",
    "check:source": "npm run check-contrast && npm run check-tokens && npm run check-text-contrast && npm run check-dynamic-el",
    "check-overlap": "node scripts/overlap-audit.mjs",
    "check-fan": "node scripts/fan-identity-check.mjs",
    "check-spacing": "node scripts/spacing-audit.mjs",
    "check-vspace": "node scripts/visual-spacing-audit.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.138",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
