---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiManual from '../../components/WikiManual.astro';
import SrcRef from '../../components/SrcRef.astro';
import { SITE } from '../../data/site';
import content from '../../data/content.json';

const pageTitle = '概览 — ' + content.hero.title;
const base = '/';

const infobox = [
  { k: '名称', v: '<strong>men（门）</strong>' },
  { k: '类型', v: 'OpenCode 原生 Agent 团队配置' },
  { k: '版本', v: `<code>${SITE.version}</code>` },
  { k: '角色数', v: '6+1（men 编排 + 5 子 Agent）' },
  { k: '许可证', v: '<code>MIT</code>' },
  { k: '仓库', v: `<a href="${SITE.repo}" target="_blank" rel="noopener">cgartlab/men</a>` },
  { k: '出品', v: SITE.brand },
];

const toc = [
  { id: 'definition', label: '定义' },
  { id: 'principles', label: '设计原则' },
  { id: 'team', label: '团队组成' },
  { id: 'quickstart', label: '快速开始' },
];

const seealso = [
  { href: base + 'docs/install', label: '安装', desc: '多平台安装命令' },
  { href: base + 'docs/configure', label: '配置', desc: '模型连接与配置' },
  { href: base + 'docs/quickstart', label: '快速上手', desc: '30 分钟跑通第一个任务' },
  { href: base + 'docs/agents', label: '角色说明', desc: '6 个 agent 详解' },
  { href: base + 'docs/protocols', label: '协议规范', desc: '验证与审计' },
  { href: base + 'docs/architecture', label: '架构设计', desc: '拓扑与流程' },
  { href: base + 'docs/governance', label: '治理', desc: '决策与发布' },
  { href: base + 'docs/releases', label: '路线图', desc: '里程碑与版本' },
];
---

<BaseLayout title={pageTitle} description="men（门）Agent 团队 — 概览">
  <WikiManual
    crumb="概览"
    title="概览"
    lead={`<strong>men（门）</strong>是一个围绕<strong>一人内容创作与工程协作</strong>设计的 Agent 编排系统：通过 6+1 角色的 Agent 团队实现任务分诊、路由分发、质量验证与自主学习，使单个开发者具备完整的团队协作能力。`}
    infoboxTitle="基本信息"
    infobox={infobox}
    toc={toc}
    seealso={seealso}
  >
    <section id="definition" class="doc-section">
      <h2>定义</h2>
      <p>
        <strong>men</strong>（门 · 编排与路由核心）是一个 <strong>OpenCode 原生 Agent 团队</strong>。
        它不是独立的可安装程序，而是一套由 <code>agent 定义 + 脚本 + 知识库</code> 组成的配置体系：
        通过 <code>opencode.json</code> 挂载 6 个角色（men / si / ji / chi / yi / xun），
        由 men 作为编排核心统一接收用户指令、判定意图、分发任务并汇总结果。
      </p>
      <dl class="wiki-term-list">
        <dt>门（men）</dt>
        <dd>编排与路由核心，用户唯一对话入口，本身不执行具体产出。</dd>
        <dt>意图门（IntentGate）</dt>
        <dd>men 内的分诊机制，将指令分为 search / analyze / team / hyperplan 四类意图。</dd>
        <dt>机械验证</dt>
        <dd>以退出码、文件存在性等机械证据为准的完成判定方式，拒绝 LLM 自评。</dd>
      </dl>
      <SrcRef files={['README.md','.opencode/agent/men.md']} />
    </section>

    <section id="principles" class="doc-section">
      <h2>设计原则</h2>
      <div class="wiki-table">
        <table>
          <thead><tr><th>#</th><th>原则</th><th>含义</th></tr></thead>
          <tbody>
            <tr><td>01</td><td><strong>机械优先</strong></td><td>完成 = 验证过的完成。所有验证基于退出码、文件存在性，拒绝 LLM 自评。</td></tr>
            <tr><td>02</td><td><strong>本地优先</strong></td><td>OpenCode 原生 agent 定义 + 自定义 command，不依赖第三方插件或云服务。</td></tr>
            <tr><td>03</td><td><strong>自治路由</strong></td><td>men 根据关键词判定表自动分类路由，低置信时向用户确认，不猜。</td></tr>
            <tr><td>04</td><td><strong>事件审计</strong></td><td>所有关键节点写入 <code>events.jsonl</code>，支持完整回放和学习回路。</td></tr>
            <tr><td>05</td><td><strong>自主学习</strong></td><td>任务完成后触发经验提取，错误模式沉淀到知识库，评估 KPI 可量化。</td></tr>
            <tr><td>06</td><td><strong>不伪造输出</strong></td><td>7 条全员红线：不跳过验证、不泄露隐私、外部操作先确认、需求模糊先问。</td></tr>
          </tbody>
        </table>
      </div>
      <SrcRef files={['AGENTS.md','docs/research/00-m0-synthesis.md']} />
    </section>

    <section id="team" class="doc-section">
      <h2>团队组成</h2>
      <p>6 个角色各司其职，men 是唯一接收用户指令的入口：</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>代号</th><th>中文名</th><th>职责</th><th>模型</th></tr></thead>
          <tbody>
            <tr><td><strong>men</strong></td><td>门</td><td>编排与路由核心</td><td><code>opencode-go/hy3</code></td></tr>
            <tr><td><strong>si</strong></td><td>思</td><td>思考与知识管理</td><td><code>sensenova/deepseek-v4-flash</code></td></tr>
            <tr><td><strong>ji</strong></td><td>记</td><td>代码与工程执行</td><td><code>opencode-go/deepseek-v4-flash</code></td></tr>
            <tr><td><strong>chi</strong></td><td>持</td><td>投资分析 + 独立评审</td><td><code>sensenova/glm-5.2</code></td></tr>
            <tr><td><strong>yi</strong></td><td>艺</td><td>文生图提示词与生图</td><td><code>sensenova/sensenova-6.8-flash-lite</code></td></tr>
            <tr><td><strong>xun</strong></td><td>寻</td><td>搜索与调研</td><td><code>sensenova/sensenova-6.8-flash-lite</code></td></tr>
          </tbody>
        </table>
      </div>
      <SrcRef files={['opencode.json','.opencode/agent/*.md']} />
    </section>

    <section id="quickstart" class="doc-section">
      <h2>快速开始</h2>
      <div class="code-block">
        <span class="code-block__lang">bash</span>
        <pre><code>git clone https://github.com/cgartlab/men.git
cd men
npx astro dev --config site/astro.config.mjs</code></pre>
      </div>
      <p>预览地址：<a href="http://localhost:4399/">http://localhost:4399/</a></p>
    </section>
  </WikiManual>
</BaseLayout>
