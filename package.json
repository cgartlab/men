{
  "name": "@cgartlab/men",
  "version": "0.3.2",
  "description": "6+1 Agent 团队系统 —— OpenCode 首发，假维斯（fakevis）出品",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "men": "scripts/install.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cgartlab/men.git"
  },
  "bugs": {
    "url": "https://github.com/cgartlab/men/issues"
  },
  "homepage": "https://github.com/cgartlab/men#readme",
  "scripts": {
    "verify": "node scripts/verify.mjs men",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "learn": "node scripts/learn.mjs",
    "learn:dry-run": "node scripts/learn.mjs --dry-run",
    "eval": "node scripts/eval-metrics.mjs",
    "eval:dry-run": "node scripts/eval-metrics.mjs --dry-run"
  },
  "files": [
    "opencode.json",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    ".env.example",
    "install.sh",
    "install.ps1",
    ".opencode/",
    "scripts/",
    "config/",
    "knowledge/"
  ],
  "exports": {
    "./server": "./.opencode/plugins/men-sidebar/index.js",
    "./tui": "./.opencode/plugins/men-sidebar/tui.js"
  },
  "dependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/keymap": "^0.5.8",
    "@opentui/solid": "^0.5.8"
  },
  "keywords": [
    "opencode",
    "agent",
    "team",
    "orchestration",
    "ai",
    "fakevis"
  ],
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
