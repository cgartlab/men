---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/content.json';
import { SITE } from '../data/site';

const PROJECTS = [
  ...content.about.projects.filter((p) => ['EDIC','Argus'].includes(p.name)).map((p) => ({ ...p, href: p.name === 'EDIC' ? 'https://github.com/cgartlab/edic-design-system' : 'https://github.com/cgartlab/argus' })),
  { name: '作品集', type: '官方站点 · 全部作品', year: '持续更新', desc: '视觉、工程与 AI 实验的完整作品档案。', href: 'https://cgartlab.com' },
  { name: '冥想系列', type: '创作企划', year: '策划中', desc: '以动态影像与声音作为媒介的冥想视觉实验系列。', href: 'https://cgartlab.com' },
];

const aboutDesc = '关于 Men（门）：CG 艺术实验室的开源协作工具 —— 出品机构、品牌方法论、作品矩阵（EDIC / Argus 等）、开源许可与联系方式。';

---

  <BaseLayout title="关于 · Men（门）" description={aboutDesc}>
<article class="about-article">

    <header class="about-header">
      <div class="about-brand-block">
        <div class="about-brand-mark" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 83.7963" fill="none"><path fill-rule="evenodd" d="M 49.4949,12.2222 C 34.4265,12.2222 33.9309,0.0 25.5529,0.0 C -3.0669,0.0 0.104,11.5407 0.104,41.3544 C 0.104,70.5679 -0.8861,74.2725 20.6975,83.2112 C 32.2645,88.0015 27.2247,61.9479 49.8298,61.9479 C 71.9301,61.9479 67.6945,87.8998 78.962,83.0437 C 100.8451,73.6126 100.8205,70.6946 99.5555,40.5173 C 98.3835,12.557 102.3083,0.0 74.4415,0.0 C 66.6945,0.0 67.0189,12.2222 49.4949,12.2222 Z M 61.7169,40.601 A 11.8034,11.8034 0 1 0 38.1101,40.601 A 11.8034,11.8034 0 1 0 61.7169,40.601 Z" fill="currentColor"/></svg>
        </div>
        <div>
          <p class="about-brand-meta">
            <span>开源项目</span>
            <span class="about-brand-meta__sep" aria-hidden="true">·</span>
            <span>{SITE.version}</span>
            <span class="about-brand-meta__sep" aria-hidden="true">·</span>
            <span>出品 {content.about.brand}</span>
          </p>
          <h1 class="about-brand-name">Men（门）</h1>
          <p class="about-brand-tagline">帮你把 AI 变成一支协作团队——说句话，自动分工、执行、验证、交付</p>
        </div>
      </div>
    </header>

    <hr class="threshold-divider" aria-hidden="true" />

    <!-- 一、Men 项目 -->
    <section class="about-section" aria-labelledby="intro-title">
      <h2 class="about-h2" id="intro-title">Men 是什么</h2>
      <p class="about-lede">
        <strong>Men（门）</strong>是 {content.about.brand} 做的一个开源工具：你跟它说一句话，
        它自动把任务拆开、派给合适的角色去做、检查做完了没有、最后给你一份报告。
        6 个角色各干各的——门管分工，思想问题，记写代码和文章，持查质量，艺做图，寻查资料。
        采用 {SITE.license} 许可，仓库
        <a href={SITE.repo} target="_blank" rel="noopener">{SITE.repoLabel}</a>。
      </p>
    </section>

    <hr class="threshold-divider" aria-hidden="true" />

    <!-- 二、出品机构 -->
    <section class="about-section" aria-labelledby="org-title">
      <h2 class="about-h2" id="org-title">01 · 出品机构 · {content.about.brand}</h2>
      <p class="about-lede">{content.about.intro}</p>
      <p class="about-lede"><strong>使命</strong>：以设计思维驱动 AI 工程实践，让个人创作者得以拥有组织级的生产力。</p>
      <p class="about-p"><strong>品牌理念</strong>：{content.about.tagline}。</p><p class="about-p"><a href="https://cgartlab.com/weekly/" target="_blank" rel="noopener"><strong>{content.about.weekly.name}</strong></a>：{content.about.weekly.desc}</p>
    </section>

        <hr class="threshold-divider" aria-hidden="true" />

    <!-- 创作哲学 -->
    <section class="about-section" aria-labelledby="phil-title">
      <h2 class="about-h2" id="phil-title">02 · 品牌方法论</h2>

      <div>
        {content.about.philosophy.map((item, i) => (
          <p class="about-p"><strong>{item.title}</strong>——{item.desc}</p>
        ))}
      </div>
    </section>

    <hr class="threshold-divider" aria-hidden="true" />

    <!-- 项目 -->
    <section class="about-section" aria-labelledby="projects-title">
      <h2 class="about-h2" id="projects-title">03 · 作品矩阵</h2>
      <p class="about-p">从设计工具到 AI Agent——这些年做的东西，都是为了解决一个具体的问题。</p>

      <div class="about-projects">
        {PROJECTS.map((proj) => (
          <div class="about-project">
            <div class="about-project__head">
              <h3 class="about-project__name">{proj.name}</h3>
              <span class="about-project__year">{proj.year}</span>
            </div>
            <p class="about-project__type">{proj.type}{proj.href && (<> · <a href={proj.href} target="_blank" rel="noopener">访问 ↗</a></>)}</p>
            <p class="about-project__desc">{proj.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="threshold-divider" aria-hidden="true" />

    <!-- 开源与许可 -->
    <section class="about-section" aria-labelledby="open-title">
      <h2 class="about-h2" id="open-title">04 · 开源与许可</h2>
      <p class="about-p">{content.about.openSource}</p>

      <div class="about-licenses">
        <div class="about-license-card">
          <span class="about-license-tag">内容</span>
          <span class="about-license-name">CC BY-NC-SA 4.0</span>
          <p>文章、设计作品、图片等创意内容采用知识共享署名-非商业性使用-相同方式共享 4.0 许可。</p>
        </div>
        <div class="about-license-card">
          <span class="about-license-tag">代码</span>
          <span class="about-license-name">MIT License</span>
          <p>主题代码、脚本、配置等软件部分采用 MIT 许可证，完全自由使用。</p>
        </div>
      </div>
    </section>

    <hr class="threshold-divider" aria-hidden="true" />

    <!-- 连接 -->
    <section class="about-section" aria-labelledby="links-title">
      <h2 class="about-h2" id="links-title">05 · 联系</h2>

      <div class="about-links">
        {content.about.links.filter((l,i,arr) => arr.findIndex(x => x.href === l.href) === i).map((link) => (
          <a href={link.href} target="_blank" rel="noopener" class="about-link">
            <span>{link.label}</span>
            <span class="about-link__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <p class="about-stack">技术栈：{content.about.stack}</p>
    </section>

    <hr class="threshold-divider" aria-hidden="true" />

    <footer class="about-footer">
      <div class="about-footer__inner">
        <div>
          <p class="about-footer__brand">{content.about.brand}</p>
          <p class="about-footer__domain">{content.about.domain} · © {content.footer.copyright}</p>
        </div>
        <div>
          <p class="about-footer__license">MIT / CC BY-NC-SA 4.0</p>
        </div>
      </div>
    </footer>

  </article>
</BaseLayout>

<style>
  .about-article {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .about-header {
    padding: var(--space-20) 0 var(--space-8);
  }

  .about-brand-block {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .about-brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    color: var(--color-accent-dark);
  }
  .about-brand-mark svg {
    width: 30px;
    height: auto;
    display: block;
  }

  .about-brand-meta {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    /* 版本 / 出品方属「该被读到」的元信息，原 fg-muted(4.54:1) 视觉过淡 → fg-tertiary */
    color: var(--color-fg-tertiary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .about-brand-meta__sep {
    /* 纯装饰分隔符（已 aria-hidden，不承载信息）。刻意用 --color-line 的浅色以
       与正文 --color-fg-muted 拉开层级；1.35:1 低于正文阈值，但 WCAG 1.4.3 对
       "pure decoration" 豁免，故不应按文本对比度判定。此前一度改成
       --color-fg-muted，与父级同值 → 规则退化为 no-op，分隔符失去作用。 */
    color: var(--color-line);
  }

  .about-brand-name {
    /* 原为 h2 档（30px）＝ 与章节标题同号 → 页标题与章节标题层级相同，
       实测 h1:30 / h2:30 并列。抬回 h1 档。 */
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-semi);
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--line-height-display);
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }

  .about-brand-tagline {
    font-size: var(--font-size-h4);
    color: var(--color-fg-secondary);
    font-weight: var(--font-weight-semi);
    line-height: 1.4;
    margin-bottom: var(--space-3);
  }

    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }
    font-weight: var(--font-weight-semi);
    color: var(--color-fg);
  }
    color: var(--color-fg-tertiary);
  }

  .about-quote {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface-warm);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semi);
    /* 中文引文不用合成斜体；行宽收到正文上限 */
    color: var(--color-fg);
    line-height: var(--line-height-relaxed);
    max-width: var(--measure-prose);
  }
  .about-quote__attr {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    font-style: normal;
    font-weight: var(--font-weight-medium);
    color: var(--color-fg-muted);
    letter-spacing: 0.03em;
  }

  .about-section {
    padding: var(--space-10) 0;
  }

  .about-h2 {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-semi);
    line-height: var(--line-height-heading);
    color: var(--color-fg);
    margin-bottom: var(--space-4);
    letter-spacing: var(--letter-spacing-heading);
  }

  .about-lede {
    font-size: var(--font-size-h4);
    color: var(--color-fg-secondary);
    line-height: var(--line-height-relaxed);
  }

  .about-p {
    font-size: var(--font-size-body);
    color: var(--color-fg);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-4);
    max-width: 68ch;
  }

  /* 创作哲学网格 */
  .about-philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .about-phil-card {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-top: 2px solid var(--color-accent);
    border-radius: var(--radius-md);
  }
  .about-phil-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-accent-dark);
    background: var(--color-accent-tint);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-2);
    font-weight: var(--font-weight-semi);
    letter-spacing: 0.02em;
  }
  .about-phil-title {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semi);
    color: var(--color-fg);
    margin-bottom: var(--space-2);
    line-height: var(--line-height-tight);
  }
  .about-phil-desc {
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    line-height: var(--line-height-relaxed);
  }

  /* 项目列表 */
  .about-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .about-project {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-left: 2px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }
  .about-project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .about-project__name {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semi);
    color: var(--color-fg);
  }
  .about-project__year {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
  }
  .about-project__type {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-accent-dark);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .about-project__desc {
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    line-height: var(--line-height-relaxed);
    max-width: var(--measure-prose);
  }

  /* 许可 */
  .about-licenses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .about-license-card {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
  }
  .about-license-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-accent-dark);
    background: var(--color-accent-tint);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-2);
    font-weight: var(--font-weight-semi);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .about-license-name {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semi);
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }
  .about-license-card p {
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    line-height: var(--line-height-relaxed);
  }

  /* 链接 */
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .about-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    color: var(--color-fg);
    text-decoration: none;
    transition: border-color var(--duration-normal) ease, color var(--duration-normal) ease;
  }
  .about-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
    text-decoration: none;
  }
  .about-link__arrow {
    color: var(--color-fg-muted);
    transition: color var(--duration-normal) ease;
  }
  .about-link:hover .about-link__arrow {
    color: var(--color-accent-dark);
  }

  .about-stack {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-fg-muted);
    margin-top: var(--space-5);
    letter-spacing: var(--letter-spacing-small);
    line-height: var(--line-height-body);
    max-width: var(--measure-prose);
  }

  /* 团队 */
  .about-team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .about-member {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
  }
  .about-member__emoji {
    font-size: 1.4rem;
    flex-shrink: 0;
    padding-top: var(--space-1);
  }
  .about-member__name {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semi);
    color: var(--color-fg);
    margin-bottom: var(--space-1);
  }
  .about-member__role {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-accent-dark);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }
  .about-member__desc {
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    line-height: var(--line-height-relaxed);
  }

  /* 底部 */
  .about-footer {
    padding: var(--space-12) 0 var(--space-4);
  }
  .about-footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line-soft);
  }
  .about-footer__brand {
    font-weight: var(--font-weight-semi);
    font-size: var(--font-size-body);
    color: var(--color-fg);
    margin-bottom: var(--space-1);
  }
  .about-footer__domain {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-fg-muted);
    letter-spacing: 0.03em;
  }
  .about-footer__license {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-fg-muted);
    text-align: right;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .about-brand-block {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .about-brand-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
    .about-brand-meta__sep { display: none; }
    .about-team-grid {
      grid-template-columns: 1fr;
    }
    .about-footer__inner {
      flex-direction: column;
      gap: var(--space-4);
    }
    .about-footer__license { text-align: left; }
  }
</style>