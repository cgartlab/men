---
import content from '../data/content.json';
import { SITE } from '../data/site';
import GateLogo from './GateLogo.astro';

const { pathname } = Astro.url;
const base = '/';

const navItems = [
  { label: '首页', href: base },
  { label: '角色', href: base + 'roles' },
  { label: '机制', href: base + 'mechanisms' },
  { label: '文档', href: base + 'docs' },
  { label: '关于', href: base + 'about' },
];

function isActive(href: string): boolean {
  if (href === base) return pathname === base || pathname === base + 'index';
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={base} class="site-header__brand" aria-label="Men 首页">
      <span class="site-header__logo" style="color: var(--color-fg)">
        <GateLogo size={22} />
      </span>
      <span class="site-header__title">Men</span>
    </a>
    <nav class="site-header__nav" aria-label="主导航">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`site-header__link ${isActive(item.href) ? 'is-active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="site-header__nav-sep" aria-hidden="true"></li>
        <li>
          <a
            href={SITE.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="site-header__gh"
            aria-label="GitHub 仓库（新窗口打开）"
          >
            GitHub ↗
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    /* 磨砂玻璃：底色 80% 不透明时 backdrop-filter 几乎看不出来（等于一块实色板），
       降到 62% 才能透出下层内容，模糊才真正起作用。

       注意 backdrop-filter 只能写标准属性：把 -webkit- 版本紧挨着写在同一条规则里，
       CSS 压缩器会当成重复声明只保留后者，实测产物里只剩 -webkit-backdrop-filter，
       而现代 Chromium 已不再把它当别名（computed 仍是 none）→ 模糊静默失效。
       带前缀的版本挪到 @supports 里，压缩器就无法去重了。 */
    background: color-mix(in oklab, var(--color-bg) 62%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    /* 玻璃质感：一条极淡的内高光 + 下方投影，把页头从内容里「抬」起来 */
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, #ffffff 55%, transparent),
      0 1px 2px color-mix(in oklab, var(--color-fg) 6%, transparent);
    border-bottom: var(--border-width) solid var(--color-line-soft);
    transition: transform var(--duration-slow) var(--ease-nav);
  }

  /* Safari 18 之前只认带前缀的写法（放在独立规则里，避免被压缩器去重） */
  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      -webkit-backdrop-filter: saturate(180%) blur(14px);
    }
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3) var(--container-padding-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    min-height: 44px;        /* 触控目标：窄屏下 27px 的链接高度太小 */
    gap: var(--space-2);
    font-weight: var(--font-weight-semi);
    font-size: var(--font-size-body);
    color: var(--color-fg);
    text-decoration: none;
    letter-spacing: var(--letter-spacing-heading);
    border-bottom: none;
  }

  .site-header__brand:hover {
    color: var(--color-fg);
    border-bottom: none;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .site-header__nav-sep {
    width: 1px;
    height: var(--space-3);
    background: var(--color-line-soft);
  }

  .site-header__link {
    font-size: var(--font-size-eyebrow-nav);
    font-weight: var(--font-weight-semi);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
    color: var(--color-fg-tertiary);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition:
      color var(--duration-normal) ease,
      border-color var(--duration-normal) ease;
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }

  .site-header__link.is-active {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }

  .site-header__gh {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow-nav);
    font-weight: var(--font-weight-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-tertiary);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-line-soft);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-normal) ease,
      border-color var(--duration-normal) ease;
    text-decoration: none;
  }

  .site-header__gh:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .site-header__inner {
      padding: var(--space-3) var(--space-6);
    }
  }

  @media (max-width: 780px) {
    .site-header__inner {
      flex-wrap: wrap;
      padding: var(--space-2) var(--space-4);
      gap: 0 var(--space-3);
    }
    .site-header__brand { flex: 1; min-width: 0; min-height: 36px; }
    .site-header__title { font-size: 0.95rem; }
    .site-header__nav { width: 100%; }
    .site-header__nav ul {
      justify-content: space-between;
      gap: var(--space-1);
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .site-header__nav ul::-webkit-scrollbar { display: none; }
    /* 页头在窄屏是两行（品牌行 + 导航行）→ 原 105px 占了 12% 屏高。
       导航行压到 32px 高（触控仍 ≥24px），整头 ≈ 76px。 */
    .site-header__link { display: inline-flex; align-items: center; min-height: 32px; padding: 4px 2px; }
    .site-header__gh { padding: 5px 9px; white-space: nowrap; min-height: 36px; display: inline-flex; align-items: center; }
  }
</style>
