---
// BackgroundCanvas — 全局底色（单层静态极淡点阵）
//
// 原为三层：静态点阵 + 20s 漂移 + 60s 网格流动。漂移与网格流动属于
// 持续运动的装饰噪音，实测在长文页面分散阅读注意力，按产品决策移除，
// 只保留一层静态极淡点阵作纸纹质感的底座（GPU 合成、零 JS、零动画）。
// 2026-10-10：首页圆环粒子层（ParticleGate）也已按产品决策移除，
// 全站不再有任何背景动画 —— 视觉只剩这层静态点阵与内容本身。
// ================================================================
---

<!-- 单层静态点阵 -->
<div class="bg-layer bg-layer-main" aria-hidden="true"></div>

<style>
  /* 单层静态点阵：纸感底座，零动画（漂移/网格流动已按产品决策移除） */
  .bg-layer-main {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--color-bg);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 6%, transparent) 0.6px,
      transparent 1.4px
    );
    background-size: 34px 34px;
  }
</style>
