---
import content from '../data/content.json';
import { SITE } from '../data/site';
import GateLogo from './GateLogo.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__primary">
      <div class="site-footer__brand">
        <span class="site-footer__logo" style="color: var(--color-fg)">
          <GateLogo size={18} minimal />
        </span>
        <span class="site-footer__name">{SITE.name}</span>
      </div>
      <div class="site-footer__version">
        <span class="site-footer__version-pin" aria-hidden="true"></span>
        <span class="site-footer__version-text">{SITE.version}</span>
      </div>
      <p class="site-footer__stack">{content.footer.stack}</p>
    </div>
    <div class="site-footer__secondary">
      <p class="site-footer__copy"><a href="https://cgartlab.com" target="_blank" rel="noopener" style="color:inherit">{content.footer.copyright}</a></p>
      <p class="site-footer__license">
        {SITE.license} ·{' '}
        <a href={SITE.repo} target="_blank" rel="noopener noreferrer">
          {SITE.repoLabel} ↗
        </a>
      </p>
    </div>
      <details class="site-footer__legal">
      <summary>法律许可与隐私声明</summary>
      <div class="site-footer__legal-body">
        <p><strong>许可</strong>：代码（Agent 定义、脚本、站点）以 MIT License 提供；文章、设计与图像等内容采用 CC BY-NC-SA 4.0，引用请注明出处。</p>
        <p><strong>隐私</strong>：本站为纯静态页面，不收集、不存储任何个人数据，不使用跟踪 Cookie 或第三方统计脚本。</p>
      </div>
    </details>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--color-line-soft);
    padding: var(--space-16) 0 var(--space-8);
    margin-top: var(--space-24);
    background: var(--color-surface-warm);
    position: relative;
    z-index: 1;
  }

  .site-footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding-x);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-8);
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
  }

  .site-footer__name {
    font-weight: var(--font-weight-semi);
    font-size: var(--font-size-body);
    color: var(--color-fg);
  }

  .site-footer__version {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .site-footer__version-pin {
    width: 2px;
    height: 12px;
    background: var(--color-accent);
    border-radius: var(--radius-xs);
  }

  .site-footer__version-text {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-fg-muted);
    letter-spacing: 0.03em;
  }

  .site-footer__stack {
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
    max-width: none;
    line-height: var(--line-height-relaxed);
  }

  .site-footer__secondary {
    text-align: right;
  }

  .site-footer__copy {
    font-size: var(--font-size-caption);
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }

  .site-footer__license {
    font-size: var(--font-size-caption);
    color: var(--color-fg-tertiary);
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .site-footer__secondary {
      text-align: left;
    }
  }

  @media (max-width: 900px) {
    .site-footer__inner {
      padding: 0 var(--space-6);
    }
  }
  .site-footer__legal { margin-top: var(--space-6); border-top: 1px dotted var(--color-line-soft); padding-top: var(--space-3); font-size: var(--font-size-caption); color: var(--color-fg-muted); }
  .site-footer__legal summary { cursor: pointer; font-family: var(--font-mono); letter-spacing: 0.04em; }
  .site-footer__legal-body p { margin-top: var(--space-2); line-height: 1.7; max-width: 68ch; }
  .site-footer__legal { margin-top: var(--space-6); border-top: 1px dotted var(--color-line-soft); padding-top: var(--space-3); font-size: var(--font-size-caption); color: var(--color-fg-muted); }
  .site-footer__legal summary { cursor: pointer; font-family: var(--font-mono); }
  .site-footer__legal-body p { margin-top: var(--space-2); line-height: 1.7; max-width: 68ch; }
  .site-footer__legal { margin-top: var(--space-6); border-top: 1px dotted var(--color-line-soft); padding-top: var(--space-3); font-size: var(--font-size-caption); color: var(--color-fg-muted); }
  .site-footer__legal summary { cursor: pointer; font-family: var(--font-mono); }
  .site-footer__legal-body p { margin-top: var(--space-2); line-height: 1.7; max-width: 68ch; }
</style>
