{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "gh-runner",
  "instructions": ["AGENTS.md", "gh-flow/AGENTS.gh-flow.md"],
  "agent": {
    "gh-runner": {
      "description": "云端执行 agent：读 issue → 建分支 → 开发 → 验证 → 开 PR。无权 merge。",
      "mode": "primary",
      "model": "sensenova/deepseek-v4-flash",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git push --force*", "effect": "deny" },
        { "action": "shell", "resource": "git push origin main*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
        { "action": "shell", "resource": "gh release*", "effect": "deny" },
        { "action": "shell", "resource": "npm publish*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
