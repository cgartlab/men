---
// HeroArt — R8.5 · 全屏动画背景画布
// 三层叠加：符号矩阵（6 角色 glyph）+ Canvas 粒子 + ASCII dither + 纸感噪点
// 性能：rAF + visibilitychange 暂停；首屏可见即激活（client:visible）
// reduced-motion: 完全静态渲染
// ================================================================
const props = Astro.props;

// 6 个 Agent 符号 + 中文单字（用于背景符号矩阵）
const GLYPHS = ['M', 'E', 'N'];
const GLYPHS_CN = ['门', '思', '记', '持', '艺', '寻'];
const GLYPHS_EN = ['M', 'S', 'J', 'C', 'Y', 'X'];
---

<section class="hero-canvas" aria-hidden="true">
  <!-- 层 1：符号矩阵（6 角色 + 中英）—— 全屏铺满，CSS 动画漂移 -->
  <div class="symbol-matrix" id="symbol-matrix"></div>

  <!-- 层 2：ASCII dither 弧线（上下渐隐遮罩） -->
  <div class="dither-band dither-band--top" aria-hidden="true">
<pre>
                   .::--==++====--::.
                .:-=+xX##88@@88##Xx+=-:.
              .:-=+xX#8@@@@@@88##Xx+=-:.
             .:-+xX#8@@@@@@@@88##Xx+=-:.
</pre>
  </div>
  <div class="dither-band dither-band--bottom" aria-hidden="true">
<pre>
             .:-+xX#8@@@@@@@@88##Xx+=-:.
              .:-=+xX#8@@@@@@88##Xx+=-:.
                .:-=+xX##88@@88##Xx+=-:.
                   .::--==++====--::.
</pre>
  </div>

  <!-- 层 3：Canvas 粒子（80 粒子 · 缓慢上升 + 视差） -->
  <canvas class="particle-canvas" id="hero-particles" width="1200" height="800" aria-hidden="true"></canvas>
</section>

<script is:inline>
  (() => {
    // ────────────────────────────────────────────
    // 符号矩阵生成（DOM，CSS 动画漂移）
    // ────────────────────────────────────────────
    const matrix = document.getElementById('symbol-matrix');
    if (matrix) {
      const GLYPHS = ['门', '思', '记', '持', '艺', '寻', 'M', 'S', 'J', 'C', 'Y', 'X', '·', '×', '◦', '▲'];
      const COLS = 40; // 每行符号数
      const ROWS = 28; // 行数（覆盖全屏）
      const total = COLS * ROWS;

      // 生成 HTML：每个 glyph 用 span，随机 delay
      let html = '';
      for (let i = 0; i < total; i++) {
        const ch = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        const delay = (Math.random() * 20).toFixed(2);
        const dur = (8 + Math.random() * 12).toFixed(1);
        const opacity = (0.04 + Math.random() * 0.08).toFixed(2);
        html += '<span data-glyph class="sym" style="--sd:' + delay + 's;--dur:' + dur + 's;opacity:' + opacity + ';">' + ch + '</span>';
      }
      matrix.innerHTML = html;
    }

    // ────────────────────────────────────────────
    // Canvas 粒子层
    // ────────────────────────────────────────────
    const canvas = document.getElementById('hero-particles');
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = window.innerWidth + 'px';
      canvas.style.height = window.innerHeight + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const PARTICLE_COUNT = 60;
    const particles = Array.from({ length: PARTICLE_COUNT }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      r: 0.5 + Math.random() * 1.5,
      speed: 0.1 + Math.random() * 0.25,
      opacity: 0.15 + Math.random() * 0.35,
      phase: Math.random() * Math.PI * 2,
      sway: 0.2 + Math.random() * 0.4,
    }));

    let mouseX = 0, mouseY = 0;
    let active = true;

    canvas.parentElement.addEventListener('mousemove', (e) => {
      mouseX = ((e.clientX / window.innerWidth) - 0.5) * 30;
      mouseY = ((e.clientY / window.innerHeight) - 0.5) * 30;
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      active = !document.hidden;
      if (active) animate();
    });

    function animate() {
      if (!active || prefersReducedMotion) return;

      const w = window.innerWidth;
      const h = window.innerHeight;
      ctx.clearRect(0, 0, w, h);

      for (const p of particles) {
        p.y -= p.speed;
        p.phase += 0.012;

        if (p.y < -6) {
          p.y = h + 6;
          p.x = Math.random() * w;
        }

        const drawX = p.x + Math.sin(p.phase) * p.sway * 8 + mouseX * 0.3;
        const drawY = p.y + mouseY * 0.2;

        ctx.beginPath();
        ctx.arc(drawX, drawY, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(232, 93, 4, ' + p.opacity + ')';
        ctx.fill();
      }

      requestAnimationFrame(animate);
    }

    if (prefersReducedMotion) {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      for (const p of particles) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(232, 93, 4, ' + (p.opacity * 0.4) + ')';
        ctx.fill();
      }
    } else {
      animate();
    }
  })();
</script>

<style>
  /* ========== 全屏背景容器 ========== */
  .hero-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }

  /* ========== 符号矩阵（层 1 · CSS 动画漂移） ========== */
  .symbol-matrix {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(40, 1fr);
    grid-auto-rows: minmax(28px, 1fr);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-accent);
    opacity: 0.7;
    mask-image: radial-gradient(ellipse at center, #000 0%, #000 35%, transparent 92%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 0%, #000 35%, transparent 92%);
    animation: sym-scroll 60s linear infinite;
    will-change: transform;
  }
  .symbol-matrix .sym {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: sym-drift 12s ease-in-out infinite;
    animation-delay: var(--sd, 0s);
  }
  @keyframes sym-scroll {
    from { transform: translateY(0); }
    to   { transform: translateY(-60%); }
  }
  @keyframes sym-drift {
    0%, 100% { opacity: var(--base-op, 0.06); transform: translate(0, 0); }
    50%      { opacity: calc(var(--base-op, 0.06) * 2.5); transform: translate(0, -4px); }
  }

  /* ========== ASCII dither 弧线带 ========== */
  .dither-band {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--color-accent);
    opacity: 0.15;
    pointer-events: none;
  }
  .dither-band pre {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: 1px;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    white-space: pre;
    text-align: center;
    mask-image: linear-gradient(transparent 0%, #000 30% 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(transparent 0%, #000 30% 70%, transparent 100%);
  }
  .dither-band--top {
    top: 4%;
    animation: dither-drift-top 16s ease-in-out infinite;
  }
  .dither-band--bottom {
    bottom: 4%;
    animation: dither-drift-bottom 16s ease-in-out infinite reverse;
  }
  @keyframes dither-drift-top {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(8px); }
  }
  @keyframes dither-drift-bottom {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* ========== Canvas 粒子层 ========== */
  .particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* ========== Reduced motion ========== */
  @media (prefers-reduced-motion: reduce) {
    .symbol-matrix { animation: none !important; }
    .symbol-matrix .sym { animation: none !important; }
    .dither-band--top, .dither-band--bottom { animation: none !important; }
  }

  @media (max-width: 768px) {
    .symbol-matrix {
      font-size: 9px;
      grid-template-columns: repeat(24, 1fr);
    }
  }
  @media (max-width: 480px) {
    .symbol-matrix {
      font-size: 7px;
      grid-template-columns: repeat(16, 1fr);
    }
    .dither-band pre {
      font-size: 7px;
    }
  }
</style>