---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiManual from '../../components/WikiManual.astro';
import content from '../../data/content.json';

const pageTitle = '角色说明 — ' + content.hero.title;
const pageDesc = '6 个 AI 帮手各自做什么、怎么配合，以及它们共同遵守的 7 条底线。';
const base = '/';

const infobox = [
  { k: '角色数', v: '<strong>6</strong>（1 个老大 + 5 个帮手）' },
  { k: '唯一入口', v: '门（men）——你只需要跟它对话就行了' },
  { k: '独立审核', v: '持（chi）——用全新视角检查别人的产出' },
];

const toc = [
  { id: 'agent-men', label: '门（men）' },
  { id: 'agent-si', label: '思（si）' },
  { id: 'agent-j', label: '记（ji）' },
  { id: 'agent-chi', label: '持（chi）' },
  { id: 'agent-yi', label: '艺（yi）' },
  { id: 'agent-xun', label: '寻（xun）' },
  { id: 'redlines', label: '7 条底线' },
];

const seealso = [
  { href: base + 'docs/architecture', label: '架构设计', desc: '团队拓扑与编排流程' },
  { href: base + 'docs/configure', label: '配置指南', desc: '修改角色定义与模型' },
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <WikiManual
    crumb="角色说明"
    title="角色说明"
    lead="6 个 AI 帮手各司其职。你不需要记住它们的名字——只需要对门说你要做什么，它会自动派给最合适的角色。下面供你想深入了解团队分工时查阅。"
    infoboxTitle="团队概要"
    infobox={infobox}
    toc={toc}
    seealso={seealso}
  >
    <section id="agent-men" class="doc-section">
      <h2>门（men）</h2>
      <p><strong>团队老大，唯一和你对话的人。</strong></p>
      <p>你说一句话，门来判断该谁来做、然后分出去。所有指令先到门这里，做完再由门汇总给你。它本身不写代码、不写文章、不画图——只负责分工和检查。</p>
    </section>

    <section id="agent-si" class="doc-section">
      <h2>思（si）</h2>
      <p><strong>想事情的。</strong></p>
      <p>遇到复杂任务时，思会先拆解成小步骤、写出方案。比如"写一篇关于 AI 的博客"，思会先想清楚结构再交给你。它也负责评估其他角色的产出质量——但只评不改。</p>
    </section>

    <section id="agent-j" class="doc-section">
      <h2>记（ji）</h2>
      <p><strong>写代码、写文章的。</strong></p>
      <p>记是干实际活的角色：写代码、写文章、修 bug、做前端页面。它做完后会先跑一遍语法检查，确认没问题才交出去。</p>
    </section>

    <section id="agent-chi" class="doc-section">
      <h2>持（chi）</h2>
      <p><strong>看质量的，用全新视角审核。</strong></p>
      <p>持有两个身份：一是做投资分析和财务数据；二是检查其他人的产出。检查的时候它会用一个全新的上下文——不看别人说了什么，只看到底做了什么。这样做能避免"自己查自己"的盲区。</p>
    </section>

    <section id="agent-yi" class="doc-section">
      <h2>艺（yi）</h2>
      <p><strong>画图的。</strong></p>
      <p>艺负责生成配图。你给它一个想法，它会先写出详细的描述提示词，然后生成图片。也负责整体视觉风格和配色方案。</p>
    </section>

    <section id="agent-xun" class="doc-section">
      <h2>寻（xun）</h2>
      <p><strong>查资料的。</strong></p>
      <p>寻负责搜网页、查新闻、核实事实。它会交叉验证信息来源，确保给你的信息是准确的。比如"查一下本周 AI 领域最新发布的大模型"——就是寻的活。</p>
    </section>

    <section id="redlines" class="doc-section">
      <h2>7 条底线</h2>
      <p>所有 6 个角色都必须遵守这 7 条底线。无论哪个角色，都不能违反：</p>
      <ol>
        <li><strong>不伪造输出</strong>：做完了才算完成，不能嘴上说说就算完事。必须有文件证据。</li>
        <li><strong>不跳过检查</strong>：做完后必须验证结果，不接受"应该没问题"。</li>
        <li><strong>不泄露隐私</strong>：你的数据、密码、个人信息不会传出去。</li>
        <li><strong>外部操作先问你</strong>：发邮件、公开发布、对外提交前，一定会先问你。</li>
        <li><strong>破坏性操作先确认</strong>：删除文件、覆盖数据等操作，不确定时会先问你。</li>
        <li><strong>需求模糊先问清楚</strong>：不脑补需求，先问清楚再动手。</li>
        <li><strong>输出格式清晰</strong>：关键信息加粗、用列表不用长段落、每段不超过 6 行。</li>
      </ol>
      <p class="src-ref">来源：<code>AGENTS.md</code> 全员红线条目</p>
    </section>
  </WikiManual>
</BaseLayout>
