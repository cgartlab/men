---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiManual from '../../components/WikiManual.astro';
import content from '../../data/content.json';

const pageTitle = '架构设计 — ' + content.hero.title;
const pageDesc = 'Men 团队的系统蓝图：6 个角色怎么协作、任务怎么流转、结果怎么被验证。';
const base = '/';

const infobox = [
  { k: '团队结构', v: '<strong>1 个老大</strong> + <strong>5 个帮手</strong>' },
  { k: '编排流程', v: '<strong>10 步</strong>自动执行' },
  { k: '验证方式', v: '<strong>两层检查</strong>：脚本查文件 + 持用全新视角审一遍' },
];

const toc = [
  { id: 'topology', label: '团队结构' },
  { id: 'orchestration', label: '任务怎么流转' },
  { id: 'verification', label: '结果怎么验证' },
  { id: 'directory', label: '文件怎么组织' },
];

const seealso = [
  { href: base + 'docs/protocols', label: '协议规范', desc: '10 步流程与自动检查' },
  { href: base + 'docs/agents', label: '角色说明', desc: '6 个角色详解' },
  { href: base + 'docs/governance', label: '治理', desc: '决策与发布' },
  { href: base + 'docs/overview', label: '概览', desc: '项目定义与团队组成' },
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <WikiManual
    crumb="架构设计"
    title="架构设计"
    lead="这是 Men 团队的系统蓝图。如果你只是想使用 Men，这一页可以跳过——它回答的是「为什么这样设计」。如果你对内部架构感兴趣，这里展示了 6 个角色如何协作、任务如何流转、结果如何被验证。"
    infoboxTitle="架构概要"
    infobox={infobox}
    toc={toc}
    seealso={seealso}
  >
    <section id="topology" class="doc-section">
      <h2>团队结构</h2>
      <p>6 个角色通过门（men）形成一个简单的结构：门是唯一接收你指令的人，也是唯一能分配任务的人。</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>谁</th><th>关系</th><th>对谁</th><th>说明</th></tr></thead>
          <tbody>
            <tr><td><strong>你</strong></td><td>只跟门说话</td><td><strong>门</strong></td><td>所有输入先到门这里</td></tr>
            <tr><td><strong>门</strong></td><td>分配任务</td><td>思 / 记 / 持 / 艺 / 寻</td><td>门来决定谁干什么</td></tr>
            <tr><td><strong>持</strong></td><td>检查别人的产出</td><td>记 / 艺 / ...</td><td>用全新视角审核</td></tr>
            <tr><td><strong>门</strong></td><td>汇报结果</td><td><strong>你</strong></td><td>最终结果回到你这里</td></tr>
          </tbody>
        </table>
      </div>
      <ul>
        <li><strong>门是唯一入口</strong>：你只跟门对话，所有输入先到门这里。</li>
        <li><strong>门是唯一分配者</strong>：5 个帮手之间不能互相分配任务——只有门能派活。</li>
        <li><strong>持是特殊的</strong>：它既做分析，又负责检查其他人的产出，用全新视角审核。</li>
      </ul>
      <p class="src-ref">参考来源：<code>docs/architecture.md</code> · 一、协作拓扑</p>
    </section>

    <section id="orchestration" class="doc-section">
      <h2>任务怎么流转</h2>
      <p>每次任务自动走完 10 步。详细流程见 <a href={base + 'docs/protocols'}>协议规范文档</a>，这里只说关键节点：</p>
      <ul>
        <li><strong>先问再动手</strong> —— 如果你说的话不清楚，门会先问你。</li>
        <li><strong>判断该派谁</strong> —— 查资料派寻，写代码派记，写方案派思，画图派艺。</li>
        <li><strong>能并行的并行</strong> —— 没依赖的任务同时做，最多 4 个一起跑。</li>
        <li><strong>做完先检查</strong> —— 先用脚本查文件，再由持用全新视角审一遍。</li>
        <li><strong>检查没过就重试</strong> —— 回到失败点重试，最多 5 次。</li>
        <li><strong>最后交报告</strong> —— 结论、关键信息、来源、待定问题。</li>
      </ul>
      <p class="src-ref">参考来源：<code>docs/architecture.md</code> · 二、编排流程</p>
    </section>

    <section id="verification" class="doc-section">
      <h2>结果怎么验证</h2>
      <p>Men 用两层检查确保产出质量。两层都过才算真正完成。</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>层</th><th>检查什么</th><th>怎么判</th></tr></thead>
          <tbody>
            <tr>
              <td><strong>第一层</strong></td>
              <td>用脚本检查：文件是否存在、有没有泄露密钥、有没有遗留 TODO、结构是否完整、退出码是否正常</td>
              <td>任一不通过就判失败</td>
            </tr>
            <tr>
              <td><strong>第二层</strong></td>
              <td>持用全新视角审核：只看实际文件，不听「我做完了」的口头汇报</td>
              <td>内容不符或质量不达标就判定失败</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="wiki-note">
        <strong>失败怎么办</strong>：任一检查没过，就回到失败点重试（不从头），最多 5 次。持连续 3 次检查不通过就停止并汇报卡住。
      </div>
      <p class="src-ref">参考来源：<code>docs/architecture.md</code> · 三、验证体系</p>
    </section>

    <section id="directory" class="doc-section">
      <h2>文件怎么组织</h2>
      <p>仓库按职责分层，所有脚本都是纯 Node、零外部依赖：</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>路径</th><th>里面放了什么</th></tr></thead>
          <tbody>
            <tr><td><code>.opencode/agent/</code></td><td>6 个角色的设定文件（门/思/记/持/艺/寻）</td></tr>
            <tr><td><code>.opencode/skills/</code></td><td>15 个技能包，教每个角色具体怎么做某类任务</td></tr>
            <tr><td><code>.opencode/command/</code></td><td>3 个自定义命令：/ultrawork、/verify、/hyperplan</td></tr>
            <tr><td><code>scripts/</code></td><td>自动检查、事件记录、经验提取等脚本</td></tr>
            <tr><td><code>docs/</code></td><td>项目文档：架构、治理、路线图等</td></tr>
            <tr><td><code>knowledge/</code></td><td>团队知识库：踩过的坑、好方法、决策记录</td></tr>
          </tbody>
        </table>
      </div>
      <p class="src-ref">参考来源：<code>docs/architecture.md</code> · 四、目录结构</p>
    </section>
  </WikiManual>
</BaseLayout>
