---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiManual from '../../components/WikiManual.astro';
import SrcRef from '../../components/SrcRef.astro';
import content from '../../data/content.json';

const pageTitle = '治理 — ' + content.hero.title;
const pageDesc = '团队怎么做决策、变更怎么审查、版本怎么发布、以及安全保障。';
const base = '/';

const infobox = [
  { k: '团队构成', v: '<strong>6 个角色</strong>（1 个老大 + 5 个帮手）。' },
  { k: '决策方式', v: '四类分级：架构 / 里程碑 / 日常 / 技术选型' },
  { k: '许可证', v: '<code>MIT</code>' },
];

const toc = [
  { id: 'roles', label: '谁管什么' },
  { id: 'decisions', label: '怎么做决策' },
  { id: 'changes', label: '变更流程' },
  { id: 'review', label: '审查' },
  { id: 'releases', label: '发布' },
  { id: 'security', label: '安全' },
];

const seealso = [
  { href: base + 'docs/releases', label: '路线图', desc: '里程碑与版本发布' },
  { href: base + 'docs/architecture', label: '架构设计', desc: '拓扑与验证体系' },
  { href: base + 'docs/protocols', label: '协议规范', desc: '流程与检查' },
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <WikiManual
    crumb="治理"
    title="治理"
    lead="这里定义了团队的协作规则——谁可以做什么、变更怎么审查、版本怎么发布。作为使用者你不需要关心这些；作为开发者贡献者，这里列出了完整的流程。"
    infoboxTitle="治理概要"
    infobox={infobox}
    toc={toc}
    seealso={seealso}
  >
    <section id="roles" class="doc-section">
      <h2>谁管什么</h2>
      <p>6 个角色各有各的分工。只有门能接收你的指令；其他 5 个角色由门来分配任务。持有个特殊身份——它负责检查别人的产出。</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>角色</th><th>职责</th></tr></thead>
          <tbody>
            <tr><td><strong>门</strong></td><td>接收指令、判断派谁、分发任务、汇总报告</td></tr>
            <tr><td><strong>思</strong></td><td>想方案、做计划、评估质量</td></tr>
            <tr><td><strong>记</strong></td><td>写代码、写文章、检查语法</td></tr>
            <tr><td><strong>持</strong></td><td>投资分析 + 用全新视角检查别人的产出</td></tr>
            <tr><td><strong>艺</strong></td><td>生成配图、决定视觉风格</td></tr>
            <tr><td><strong>寻</strong></td><td>查资料、核实事实</td></tr>
          </tbody>
        </table>
      </div>
      <ul>
        <li><strong>入口唯一</strong>：你只跟门对话。其他角色不能直接和你交互。</li>
        <li><strong>持是独立的</strong>：持检查别人产出时，用全新的上下文——不看别人说了什么，只看到底做了什么。</li>
      </ul>
      <SrcRef files={['docs/governance.md']} />
    </section>

    <section id="decisions" class="doc-section">
      <h2>怎么做决策</h2>
      <p>决策分四类，按影响范围来定：</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>类型</th><th>例子</th><th>谁来决定</th></tr></thead>
          <tbody>
            <tr><td><strong>架构决策</strong></td><td>新增角色、改系统结构</td><td>门 + 核心成员讨论</td></tr>
            <tr><td><strong>里程碑决策</strong></td><td>版本启动条件</td><td>门</td></tr>
            <tr><td><strong>日常决策</strong></td><td>改某个技能包、改某个脚本</td><td>对应角色自己决定</td></tr>
            <tr><td><strong>技术选型</strong></td><td>用什么语言、用什么工具</td><td>门 + 记</td></tr>
          </tbody>
        </table>
      </div>
      <p>重要决策会记录下来，包含：决策编号、内容、依据、状态。</p>
      <div class="wiki-note">
        <strong>回滚机制</strong>：如果某次改动导致问题，可以回退到上一版本。回滚原因被记录下来。
      </div>
      <SrcRef files={['docs/governance.md']} />
    </section>

    <section id="changes" class="doc-section">
      <h2>变更流程</h2>
      <p>修改不同文件有不同要求：</p>
      <ul>
        <li><strong>改角色设定</strong>：先读后改，保留必要字段，红线部分逐字一致</li>
        <li><strong>改技能包</strong>：保留使用说明和触发条件，步骤编号连续</li>
        <li><strong>改脚本</strong>：改完必须跑一次自动检查，确认没问题</li>
        <li><strong>改配置</strong>：验证 JSON 格式正确，同步更新相关文档</li>
      </ul>
      <SrcRef files={['docs/governance.md']} />
    </section>

    <section id="review" class="doc-section">
      <h2>审查</h2>
      <p>从提交修改到合并的完整流程：</p>
      <ol>
        <li><strong>提交修改</strong> —— 开发者提交代码变更</li>
        <li><strong>自审确认</strong> —— 提交人对照清单逐项确认</li>
        <li><strong>自动检查</strong> —— 跑脚本检查（文件存在、无密钥泄露、无遗留 TODO 等）</li>
        <li><strong>持审</strong> —— 持用全新视角复核内容质量</li>
        <li><strong>裁决</strong> —— 通过就合并；不通过就修复后重新提交；卡住了就停止并汇报</li>
      </ol>
      <div class="wiki-note">
        <strong>合并策略</strong>：默认压缩合并（squash merge），合并后删除分支。
      </div>
      <SrcRef files={['docs/governance.md']} />
    </section>

    <section id="releases" class="doc-section">
      <h2>发布</h2>
      <p>遵循语义化版本（SemVer）：</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>版本类型</th><th>触发条件</th></tr></thead>
          <tbody>
            <tr><td><strong>大版本</strong></td><td>不兼容的改动（如角色变更、协议变更）</td></tr>
            <tr><td><strong>小版本</strong></td><td>新功能（如新增技能包、新增命令）</td></tr>
            <tr><td><strong>补丁版本</strong></td><td>修复问题（如 bug 修复、文档修正）</td></tr>
          </tbody>
        </table>
      </div>
      <p class="src-ref">来源：<a href="https://semver.org/lang/zh-CN/" target="_blank" rel="noopener">语义化版本 2.0.0</a></p>
      <SrcRef files={['docs/governance.md']} />
    </section>

    <section id="security" class="doc-section">
      <h2>安全</h2>
      <h3>安全底线</h3>
      <ul>
        <li>密钥文件不能提交到版本控制</li>
        <li>密码、API key 不能出现在任何文档或任何代码中</li>
        <li>安全漏洞报告：72 小时内响应</li>
      </ul>
      <h3>漏洞报告方式</h3>
      <ul>
        <li><strong>GitHub Issue</strong> —— 提交标记为 security 的 Issue</li>
        <li><strong>邮件</strong> —— 发送到 hello@cgartlab.com</li>
      </ul>
      <p class="src-ref">来源：<code>SECURITY.md</code></p>
    </section>
  </WikiManual>
</BaseLayout>
