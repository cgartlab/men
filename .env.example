# men（门）Agent 团队 — 环境变量模板
# 使用方法：复制为 .env 后填写真实值
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
# .env 已被 .gitignore 排除，不会进入版本控制

# ── 必填：Embedding（知识检索 / RAG 使用）──
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://your-embedding-service.example.com/v1
EMBEDDING_MODEL=your-embedding-model-name

# ── 可选：内网数据源（192.168.31.x 局域网服务）──
# SearXNG 实例地址（本地隐私搜索）
# SEARXNG_URL=http://192.168.31.111:8099
# Miniflux RSS 聚合器
# MINIFLUX_URL=http://192.168.31.111:8025
# Wealth Tracker API
# WEALTH_TRACKER_URL=http://192.168.31.111:8888

# ── 可选：OpenAI 兼容接口（如本地模型网关）──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── 可选：内网数据源（192.168.31.x 局域网服务）──
# 内网地址与凭据一律只写在此处，禁止写入代码与配置文件
# LAN_DATA_URL=
# LAN_DATA_TOKEN=

# ── 可选：OpenCode 模型配置（默认由 opencode.json 管理）──
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=
