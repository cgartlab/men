---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiManual from '../../components/WikiManual.astro';
import content from '../../data/content.json';

const pageTitle = '角色说明 — ' + content.hero.title;
const base = '/';

/* 每个角色的准确标签（来源：AGENTS.md / .opencode/agent/*.md） */
const roleTags: Record<string, string[]> = {
  men: ['primary', 'router', 'auditor'],
  si: ['subagent', 'thinker', 'knowledge'],
  ji: ['subagent', 'engineer', 'l1-verify'],
  chi: ['subagent', 'data', 'investor', 'judge'],
  yi: ['subagent', 'aesthetic', 'prompt-engine'],
  xun: ['subagent', 'researcher', 'verify-first'],
};

const infobox = [
  { k: '角色数', v: '<strong>6</strong>（1 primary + 5 subagent）' },
  { k: '唯一入口', v: 'men（门）' },
  { k: '唯一 spawner', v: 'men（子 Agent 禁止互相 spawn）' },
  { k: '独立 Judge', v: 'chi（fresh-context spawn）' },
  { k: '共享约定', v: '全员红线 7 条 + <code>CHARTER_CHECK</code>' },
];

const toc = [
  { id: 'agent-men', label: 'men（门）' },
  { id: 'agent-si', label: 'si（思）' },
  { id: 'agent-ji', label: 'ji（记）' },
  { id: 'agent-chi', label: 'chi（持）' },
  { id: 'agent-yi', label: 'yi（艺）' },
  { id: 'agent-xun', label: 'xun（寻）' },
  { id: 'routing', label: '路由判定表' },
  { id: 'intentgate', label: '意图门 IntentGate' },
  { id: 'redlines', label: '全员红线' },
];

const seealso = [
  { href: base + 'docs/protocols', label: '协议规范', desc: '10 步协议与验证审计' },
  { href: base + 'docs/architecture', label: '架构设计', desc: '协作拓扑与编排流程' },
  { href: base + 'docs/configure', label: '配置指南', desc: '修改 agent 定义与模型' },
];
---

<BaseLayout title={pageTitle} description="men（门）Agent 团队 — 角色说明">
  <WikiManual
    crumb="角色说明"
    title="角色说明"
    lead="6 个 agent 各司其职，由 <strong>men（门）</strong>统一编排。每个角色都有明确的职责边界、路由规则和验收标准——绝不越界，绝不猜需求。"
    infoboxTitle="团队概要"
    infobox={infobox}
    toc={toc}
    seealso={seealso}
  >
    {content.roles.map((role, i) => (
      <section id={'agent-' + role.name} class="doc-section">
        <h2>{String(i + 1).padStart(2, '0')} · {role.cn}（<code>{role.name}</code>）</h2>
        <p>
          <strong>{role.desc}</strong>
        </p>
        <p class="src-ref">mode：<code>{role.mode}</code></p>
        <div class="wiki-note">
          {roleTags[role.name]?.map((t) => `<span class="wiki-tag">${t}</span>`).join(' ') ?? ''}
        </div>
      </section>
    ))}

    <section id="routing" class="doc-section">
      <h2>路由判定表</h2>
      <p>用户指令到达 men 后，按以下规则路由到目标 agent：</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>任务类型</th><th>目标 Agent</th><th>意图类别</th></tr></thead>
          <tbody>
            <tr><td>代码 / GitHub / 工程</td><td><strong>ji</strong>（记）</td><td><code>team</code></td></tr>
            <tr><td>写作 / 内容 / 博客 / 周报</td><td><strong>ji</strong>（记）</td><td><code>team</code></td></tr>
            <tr><td>方案思考 / 知识管理 / 深度研究 / 规划</td><td><strong>si</strong>（思）</td><td><code>team</code></td></tr>
            <tr><td>信息收集 / 搜索 / 新闻 / 事实核查</td><td><strong>xun</strong>（寻）</td><td><code>search</code></td></tr>
            <tr><td>投资 / 财务 / 市场分析 / 数据统计</td><td><strong>chi</strong>（持）</td><td><code>team</code></td></tr>
            <tr><td>审美 / 文生图提示词 / 生图</td><td><strong>yi</strong>（艺）</td><td><code>team</code></td></tr>
            <tr><td>混合 / 模糊</td><td><strong>men</strong> → 多路并行 + 汇总</td><td><code>team / hyperplan</code></td></tr>
            <tr><td>分析 / 验证 / 评审</td><td><strong>相关专家 + chi</strong>（judge）</td><td><code>analyze</code></td></tr>
          </tbody>
        </table>
      </div>
      <p class="src-ref">来源：<code>.opencode/agent/men.md</code> 路由判定表</p>
    </section>

    <section id="intentgate" class="doc-section">
      <h2>意图门（IntentGate）</h2>
      <p>men 在分诊阶段将用户指令分为四类意图，低置信时向用户确认、不猜：</p>
      <div class="wiki-table">
        <table>
          <thead><tr><th>意图</th><th>触发关键词</th><th>执行路径</th><th>涉及 Agent</th></tr></thead>
          <tbody>
            <tr><td><code>search</code></td><td>查信息 / 新闻 / 资料 / 核查</td><td>xun 单路研究</td><td>xun</td></tr>
            <tr><td><code>analyze</code></td><td>分析 / 评估 / 诊断 / 评审</td><td>专家产出 + judge 复核</td><td>si/ji/chi + chi（judge）</td></tr>
            <tr><td><code>team</code></td><td>多领域 / 跨领域综合</td><td>多路并行 + si 规划（必要时）</td><td>任意组合</td></tr>
            <tr><td><code>hyperplan</code></td><td>复杂项目启动 / 从零规划</td><td>深度思考多角度方案 → 拆解 → 执行</td><td>si + 后续各角色</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="redlines" class="doc-section">
      <h2>全员红线（7 条）</h2>
      <p>6 个 agent 必须逐字遵守：</p>
      <ol>
        <li><strong>不伪造输出</strong>：完成 = 验证过的完成。声称完成前必须有机械证据（退出码 0 / 产物文件存在）</li>
        <li><strong>不跳过验证</strong>：执行后必须确认结果，不接受"应该没问题"</li>
        <li><strong>不泄露用户隐私</strong>：用户数据、API key、个人信息不外传</li>
        <li><strong>外部操作先确认</strong>：发邮件、公开发布、对外提交前必须征得用户同意</li>
        <li><strong>破坏性操作先询问</strong>：trash &gt; rm，不确定时问用户</li>
        <li><strong>需求模糊先问清楚</strong>：不脑补需求，澄清优先于行动</li>
        <li><strong>输出格式</strong>：粗体关键信息、列表优先于段落、单段 ≤6 行</li>
      </ol>
      <p class="src-ref">来源：<code>AGENTS.md</code> 全员红线条目</p>
    </section>
  </WikiManual>
</BaseLayout>

<style is:global>
  .wiki-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-accent-dark);
    background: var(--color-accent-tint);
    padding: 1px var(--space-2);
    border-radius: var(--radius-xs);
    letter-spacing: 0.05em;
    margin-right: var(--space-1);
  }
  .wiki-note .wiki-tag { background: var(--color-surface); border: 1px solid var(--color-line); }
</style>
