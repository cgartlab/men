  <!-- ===== FAQ ===== -->
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="faq__title">常见问题</h2>
    <div class="faq__list">
      {(faq.length > 0 ? faq : [
        { q: 'men 是什么？', a: '6+1 角色的 Agent 编排系统，围绕一人内容创作与工程协作设计。所有定义、脚本、知识库托管在 GitHub。' },
        { q: '如何使用？', a: '克隆仓库，运行 <code>npx astro dev --config site/astro.config.mjs</code>，浏览器打开 <code>localhost:4399/</code>。' },
        { q: '可以自定义角色吗？', a: '编辑 <code>.opencode/agent/*.md</code>，修改 <code>opencode.json</code>，重新同步。详见配置指南。' },
        { q: '如何验证？', a: '运行 <code>node scripts/verify.mjs</code>，五项机械检查全 PASS 即可。' },
      ]).map((item) => (
        <details class="faq__item">
          <summary class="faq__q">{item.q}</summary>
          <p class="faq__a" set:html={item.a}></p>
        </details>
      ))}
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta" aria-label="开始使用">
    <div class="cta__inner">
      <h2 class="cta__title">现在就<em>推门而入</em></h2>
      <p class="cta__desc">认识角色，了解机制，开始协作。</p>
      <div class="cta__actions">
        <a href={base + 'roles'} class="hero-cta hero-cta--primary">认识角色 <Icon name="lucide:arrow-right" width="14" height="14" /></a>
        <a href={base + 'mechanisms'} class="hero-cta hero-cta--ghost">核心机制 <Icon name="lucide:arrow-right" width="14" height="14" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
  :root { --page-max: 720px; }

  /* ===== Hero ===== */
  .hero { text-align: center; padding: var(--space-12) 0 var(--space-8); position: relative; overflow: hidden; }
  .hero-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; padding: 0 var(--space-6); }
  .hero-logo { color: var(--color-accent); filter: drop-shadow(0 0 24px color-mix(in srgb, var(--color-accent) 30%, transparent)); margin-bottom: var(--space-3); }
  .hero-eyebrow { font-family: var(--font-mono); font-size: var(--font-size-eyebrow); font-weight: var(--font-weight-semi); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-fg-muted); margin-bottom: var(--space-3); }
  .hero-title { font-size: var(--font-size-display); font-weight: var(--font-weight-semi); line-height: 1.1; letter-spacing: -0.03em; color: var(--color-fg); text-wrap: balance; max-width: 18ch; margin: 0 auto var(--space-3); }
  .hero-desc { font-size: var(--font-size-body); color: var(--color-fg-secondary); max-width: 520px; line-height: var(--line-height-body); margin: 0 auto; }
  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; margin-top: var(--space-6); }
  .hero-cta { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-5); font-family: var(--font-mono); font-size: var(--font-size-caption); font-weight: var(--font-weight-semi); text-decoration: none; border: 1px solid var(--color-accent); border-radius: var(--radius-sm); transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .hero-cta--primary { background: var(--color-accent); color: #fff; }
  .hero-cta--primary:hover { background: color-mix(in srgb, var(--color-accent) 85%, #fff); border-color: color-mix(in srgb, var(--color-accent) 85%, #fff); text-decoration: none; }
  .hero-cta--ghost { background: var(--color-surface); color: var(--color-fg); border-color: var(--color-line); }
  .hero-cta--ghost:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-tint); text-decoration: none; }
  .hero-version { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-8); font-family: var(--font-mono); font-size: var(--font-size-eyebrow); color: var(--color-fg-muted); }
  .hero-version-badge { font-weight: var(--font-weight-semi); color: #fff; background: var(--color-accent); padding: 1px var(--space-2); border-radius: var(--radius-xs); }

  /* ===== Install / Terminal (Light Theme) ===== */
  .install { padding: var(--space-8) 0 var(--space-12); max-width: var(--page-max); margin: 0 auto; padding-left: var(--space-6); padding-right: var(--space-6); }
  .install__header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-4); }
  .install__title { font-family: var(--font-serif); font-size: var(--font-size-h3); font-weight: var(--font-weight-semi); color: var(--color-fg); }
  .install__guide { font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-fg-muted); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-1); transition: color 0.2s; }
  .install__guide:hover { color: var(--color-accent); text-decoration: none; }

  .terminal { background: #f6f8fa; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid #d0d7de; }
  .terminal__chrome { display: flex; align-items: center; gap: var(--space-4); padding: 10px var(--space-4); background: #eaeef2; border-bottom: 1px solid #d0d7de; }
  .terminal__dots { display: flex; gap: 8px; flex-shrink: 0; }
  .terminal__dot { width: 12px; height: 12px; border-radius: 50%; }
  .terminal__dot--red { background: #ff5f57; }
  .terminal__dot--yellow { background: #febc2e; }
  .terminal__dot--green { background: #28c840; }
  .terminal__tabs { display: flex; gap: 0; flex: 1; overflow-x: auto; }
  .terminal__tab {
    font-family: var(--font-mono); font-size: var(--font-size-caption); font-weight: var(--font-weight-semi);
    color: #656d76; background: none; border: none; border-bottom: 2px solid transparent;
    padding: 6px var(--space-4); cursor: pointer; white-space: nowrap; transition: color 0.2s, border-color 0.2s;
  }
  .terminal__tab[aria-selected="true"] { color: #1f2328; border-bottom-color: #e85d04; }
  .terminal__tab:hover { color: #1f2328; }

  .terminal__body { padding: var(--space-5) var(--space-6); min-height: 120px; }
  .terminal__intro { font-family: var(--font-mono); font-size: var(--font-size-eyebrow); color: #656d76; margin-bottom: var(--space-4); line-height: 1.6; }
  .terminal__hint { font-family: var(--font-mono); font-size: 0.68rem; color: #8b949e; margin-top: var(--space-3); line-height: 1.5; }
  .terminal__cmd { margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid #d8dee4; }
  .terminal__cmd:last-child { margin-bottom: 0; border-bottom: none; padding-bottom: 0; }
  .terminal__cmd-meta { display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: 6px; flex-wrap: wrap; }
  .terminal__cmd-label { font-family: var(--font-mono); font-size: var(--font-size-caption); font-weight: var(--font-weight-semi); color: #1f2328; }
  .terminal__cmd-desc { font-family: var(--font-mono); font-size: 0.68rem; color: #8b949e; }
  .terminal__cmd-line {
    display: flex; align-items: flex-start; gap: var(--space-2);
    background: #fff; border: 1px solid #d0d7de; border-radius: 6px; padding: 10px var(--space-3);
  }
  .terminal__ps1 { font-family: var(--font-mono); font-size: var(--font-size-body); color: #e85d04; flex-shrink: 0; font-weight: var(--font-weight-bold); line-height: 1.5; }
  .terminal__ps1--agent { color: #0969da; }
  .terminal__cmd-line code {
    font-family: var(--font-mono); font-size: var(--font-size-body); color: #1f2328;
    flex: 1; min-width: 0; word-break: break-word; line-height: 1.5; white-space: pre-wrap;
  }
  .terminal__copy {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border: 1px solid #d0d7de; border-radius: 6px;
    background: #f6f8fa; color: #656d76; cursor: pointer; transition: all 0.2s;
  }
  .terminal__copy:hover { color: #e85d04; border-color: #e85d04; background: #fff; }
  .terminal__panel { display: block; }
  .terminal__panel[hidden] { display: none; }

  /* ===== Showcase (scroll-driven agent cards) ===== */
  .showcase { padding: var(--space-12) 0 var(--space-8); overflow: hidden; }
  .showcase__header { text-align: center; padding: 0 var(--space-6); margin-bottom: var(--space-8); }
  .showcase__label { font-family: var(--font-mono); font-size: var(--font-size-eyebrow); font-weight: var(--font-weight-semi); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-3); }
  .showcase__heading { font-family: var(--font-serif); font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: var(--font-weight-semi); color: var(--color-fg); line-height: 1.15; margin-bottom: var(--space-3); }
  .showcase__sub { font-size: var(--font-size-body); color: var(--color-fg-tertiary); }

  .showcase__track {
    position: relative;
    display: flex; gap: var(--space-5);
    padding: var(--space-4) var(--space-6);
    overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .showcase__track::-webkit-scrollbar { display: none; }

  .showcase__card {
    flex: 0 0 320px; scroll-snap-align: start;
    background: var(--color-surface); border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-lg); padding: var(--space-6);
    display: flex; flex-direction: column; gap: var(--space-3);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
    position: relative; overflow: hidden;
  }
  .showcase__card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--card-accent); opacity: 0; transition: opacity 0.3s;
  }
  .showcase__card:hover { border-color: var(--card-accent); box-shadow: 0 8px 32px rgba(0,0,0,0.06); transform: translateY(-2px); }
  .showcase__card:hover::before { opacity: 1; }
  .showcase__card.is-visible { opacity: 1; transform: translateY(0); }
  .showcase__card:not(.is-visible) { opacity: 0; transform: translateY(24px); }

  .showcase__card-icon { color: var(--card-accent); }
  .showcase__card-head { display: flex; align-items: baseline; gap: var(--space-2); }
  .showcase__card-cn { font-family: var(--font-serif); font-size: var(--font-size-h2); font-weight: var(--font-weight-semi); color: var(--color-fg); }
  .showcase__card-id { font-family: var(--font-mono); font-size: var(--font-size-caption); color: var(--color-fg-muted); }
  .showcase__card-role { font-family: var(--font-mono); font-size: var(--font-size-caption); font-weight: var(--font-weight-semi); color: var(--card-accent); }
  .showcase__card-desc { font-size: var(--font-size-caption); color: var(--color-fg-secondary); line-height: var(--line-height-relaxed); }
  .showcase__card-skills { display: flex; flex-wrap: wrap; gap: 6px; }
  .showcase__skill {
    font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-fg-tertiary);
    background: var(--color-bg-warm); padding: 2px 8px; border-radius: var(--radius-xs);
    border: 1px solid var(--color-line-soft);
  }
  .showcase__card-constraint {
    font-size: 0.72rem; color: var(--color-fg-muted); font-style: italic;
    display: flex; align-items: center; gap: var(--space-1); margin-top: auto;
    padding-top: var(--space-2); border-top: 1px solid var(--color-line-soft);
  }

  /* Team traits card */
  .showcase__card--team { flex: 0 0 360px; background: var(--color-bg-warm); }
  .showcase__team-traits { display: flex; flex-direction: column; gap: var(--space-3); }
  .showcase__trait { display: flex; gap: var(--space-3); align-items: flex-start; }
  .showcase__trait svg { color: var(--color-accent); flex-shrink: 0; margin-top: 2px; }
  .showcase__trait strong { display: block; font-size: var(--font-size-caption); font-weight: var(--font-weight-semi); color: var(--color-fg); margin-bottom: 1px; }
  .showcase__trait span { font-size: 0.72rem; color: var(--color-fg-tertiary); line-height: 1.4; }

  /* Showcase nav */
  .showcase__nav { display: flex; align-items: center; justify-content: center; gap: var(--space-4); margin-top: var(--space-5); }
  .showcase__arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--color-line); background: var(--color-surface);
    color: var(--color-fg-secondary); cursor: pointer;
    transition: all 0.2s; flex-shrink: 0;
  }
  .showcase__arrow:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-tint); }
  .showcase__arrow:active { transform: scale(0.92); }
  .showcase__dots { display: flex; gap: 8px; align-items: center; }
  .showcase__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-line); border: none; padding: 0; cursor: pointer;
    transition: all 0.25s;
  }
  .showcase__dot--active { background: var(--color-accent); width: 24px; border-radius: 4px; }

  /* ===== Topology ===== */
  .topo { padding: var(--space-10) 0 var(--space-12); max-width: 1000px; margin: 0 auto; padding-left: var(--space-6); padding-right: var(--space-6); }
  .topo__header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-3); }
  .topo__title { font-family: var(--font-serif); font-size: var(--font-size-h3); font-weight: var(--font-weight-semi); color: var(--color-fg); }
  .topo__all { font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-fg-muted); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-1); transition: color 0.2s; }
  .topo__all:hover { color: var(--color-accent); text-decoration: none; }
  .topo__desc { font-size: var(--font-size-caption); color: var(--color-fg-tertiary); margin-bottom: var(--space-6); }
  .topo-diagram { overflow-x: auto; }
  .topo-svg { width: 100%; height: auto; min-width: 860px; }

  /* Bézier lines */
  .topo-bezier { fill: none; stroke-width: 1.5; }
  .topo-bezier--input { stroke: #8b949e; }
  .topo-bezier--branch { stroke: #e85d04; stroke-opacity: 0.45; }
  .topo-bezier--return { stroke: #2ea043; stroke-opacity: 0.6; stroke-dasharray: 6 4; }
  .topo-bezier--verdict { stroke: #2ea043; stroke-width: 1.8; }
  .topo-bezier--fail { stroke: #bf8700; stroke-opacity: 0.7; stroke-dasharray: 5 4; }
  .topo-bezier--report { stroke: #2ea043; stroke-opacity: 0.7; stroke-width: 1.8; }
  .topo-bezier--learn { stroke: #8b5cf6; stroke-opacity: 0.85; stroke-dasharray: 2 4; }
  .topo-bezier--judge { stroke: #bf8700; stroke-opacity: 0.7; stroke-dasharray: 4 3; stroke-width: 1.2; }

  /* Animated dots */
  .topo-dot { fill: #e85d04; }
  .topo-dot--input { fill: #8b949e; }
  .topo-dot--return { fill: #2ea043; }
  .topo-dot--verdict { fill: #2ea043; }
  .topo-dot--fail { fill: #bf8700; }
  .topo-dot--report { fill: #2ea043; }
  .topo-dot--learn { fill: #8b5cf6; }
  .topo-dot--judge { fill: #bf8700; }

  /* Nodes */
  .topo-node { rx: 10; ry: 10; }
  .topo-node--input { fill: #f6f8fa; stroke: #d0d7de; stroke-width: 1; }
  .topo-node--hub { fill: #e85d04; stroke: none; }
  .topo-node--agent { fill: #f6f8fa; stroke: #d0d7de; stroke-width: 1; }
  .topo-node--judge { fill: #f6f8fa; stroke: #bf8700; stroke-width: 1.5; }
  .topo-node--output { fill: #f6f8fa; stroke: #d0d7de; stroke-width: 1; }
  .topo-node--verify { fill: #f6f8fa; stroke: #2ea043; stroke-width: 1.5; }
  .topo-node--knowledge { fill: #fafafa; stroke: #8b5cf6; stroke-width: 1.2; stroke-dasharray: 5 4; }
  .topo-badge { fill: #bf8700; fill-opacity: 0.14; stroke: #bf8700; stroke-opacity: 0.5; stroke-width: 1; }

  /* Labels */
  .topo-label { font-family: var(--font-mono); }
  .topo-label--input { fill: #1f2328; font-size: 16px; font-weight: 600; }
  .topo-label--sub { fill: #656d76; font-size: 11px; font-weight: 400; }
  .topo-label--hub-cn { fill: #fff; font-size: 20px; font-weight: 700; }
  .topo-label--hub-sub { fill: rgba(255,255,255,0.85); font-size: 12px; }
  .topo-label--agent-cn { fill: #1f2328; font-size: 16px; font-weight: 700; }
  .topo-label--agent-id { fill: #656d76; font-size: 11px; }
  .topo-label--judge-cn { fill: #1f2328; font-size: 15px; font-weight: 600; }
  .topo-label--judge-sub { fill: #656d76; font-size: 11px; }
  .topo-label--judge-tag { fill: #bf8700; font-size: 11px; font-weight: 600; font-style: italic; }
  .topo-label--badge { fill: #bf8700; font-size: 9px; font-weight: 600; }
  .topo-label--hub-sub2 { fill: rgba(255,255,255,0.75); font-size: 10px; }
  .topo-label--node-title { fill: #1f2328; font-size: 13px; font-weight: 600; }
  .topo-label--node-sub { fill: #656d76; font-size: 10px; }
  .topo-label--node-micro { fill: #8b949e; font-size: 8.5px; }
  .topo-elabel { font-family: var(--font-mono); font-size: 11px; font-weight: 600; }
  .topo-elabel--pass { fill: #2ea043; }
  .topo-elabel--fail { fill: #bf8700; }
  .topo-elabel--report { fill: #2ea043; }
  .topo-label--output { fill: #1f2328; font-size: 16px; font-weight: 600; }

  /* Pulse animation on hub */
  .topo-pulse {
    fill: none; stroke: #e85d04; stroke-width: 2; opacity: 0;
    animation: topo-pulse 3s ease-out infinite;
  }
  @keyframes topo-pulse {
    0% { opacity: 0.6; stroke-width: 2; }
    100% { opacity: 0; stroke-width: 8; }
  }

  /* Status dots on nodes */
  .topo-status { fill: #2ea043; }
  .topo-status--active { animation: topo-blink 2s ease-in-out infinite; }
  .topo-status--verify { fill: #bf8700; animation: topo-blink 1.5s ease-in-out infinite; }
  @keyframes topo-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .topo-legend { display: flex; gap: var(--space-5); justify-content: center; padding-top: var(--space-5); flex-wrap: wrap; }
  .topo-legend__item { display: inline-flex; align-items: center; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--font-size-eyebrow); color: var(--color-fg-muted); }
  .topo-legend__dot { width: 8px; height: 8px; border-radius: 50%; }
  .topo-legend__dot--input { background: #8b949e; }
  .topo-legend__dot--hub { background: #e85d04; }
  .topo-legend__dot--agent { background: #f6f8fa; border: 1px solid #d0d7de; }
  .topo-legend__dot--judge { background: #f6f8fa; border: 1.5px solid #bf8700; }
  .topo-legend__dot--verify { background: #f6f8fa; border: 1.5px solid #2ea043; }
  .topo-legend__dot--report { background: #2ea043; }
  .topo-legend__dot--fail { background: #bf8700; }

  /* ===== Mechanisms ===== */
  .mechanisms { padding: var(--space-10) 0; max-width: var(--page-max); margin: 0 auto; padding-left: var(--space-6); padding-right: var(--space-6); }
  .mechanisms__header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-5); }
  .mechanisms__title { font-family: var(--font-serif); font-size: var(--font-size-h3); font-weight: var(--font-weight-semi); color: var(--color-fg); }
  .mechanisms__all { font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-fg-muted); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-1); transition: color 0.2s; }
  .mechanisms__all:hover { color: var(--color-accent); text-decoration: none; }
  .mechanisms__list { display: flex; flex-direction: column; }
  .mechanisms__item { display: flex; gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line-soft); transition: background 0.2s; }
  .mechanisms__item:last-child { border-bottom: none; }
  .mechanisms__idx { font-family: var(--font-mono); font-size: var(--font-size-eyebrow); color: var(--color-fg-muted); flex-shrink: 0; padding-top: 2px; letter-spacing: 0.05em; }
  .mechanisms__item-body { flex: 1; }
  .mechanisms__item-title { font-size: var(--font-size-body); font-weight: var(--font-weight-semi); color: var(--color-fg); margin-bottom: 2px; }
  .mechanisms__item-desc { font-size: var(--font-size-caption); color: var(--color-fg-tertiary); line-height: var(--line-height-relaxed); }

  /* ===== FAQ ===== */
  .faq { padding: var(--space-10) 0 var(--space-12); max-width: var(--page-max); margin: 0 auto; padding-left: var(--space-6); padding-right: var(--space-6); }
  .faq__title { font-family: var(--font-serif); font-size: var(--font-size-h3); font-weight: var(--font-weight-semi); color: var(--color-fg); margin-bottom: var(--space-5); }
  .faq__item { border-bottom: 1px solid var(--color-line-soft); }
  .faq__q { font-size: var(--font-size-body); font-weight: var(--font-weight-semi); color: var(--color-fg); padding: var(--space-3) 0; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after { content: '+'; font-family: var(--font-mono); font-size: var(--font-size-h4); color: var(--color-fg-muted); transition: transform 0.2s; }
  .faq__item[open] .faq__q::after { transform: rotate(45deg); }
  .faq__a { font-size: var(--font-size-caption); color: var(--color-fg-tertiary); line-height: var(--line-height-relaxed); padding-bottom: var(--space-3); }
  .faq__a code { font-family: var(--font-mono); background: var(--color-bg-warm); padding: 1px var(--space-1); border-radius: var(--radius-xs); color: var(--color-fg); font-size: 0.85em; }

  /* ===== CTA ===== */
  .cta { padding: var(--space-12) 0; max-width: var(--page-max); margin: 0 auto; padding-left: var(--space-6); padding-right: var(--space-6); }
  .cta__inner { text-align: center; padding: var(--space-10) 0; border-top: 1px solid var(--color-line-soft); }
  .cta__title { font-family: var(--font-serif); font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: var(--font-weight-semi); line-height: 1.12; letter-spacing: -0.025em; color: var(--color-fg); margin-bottom: var(--space-3); }
  .cta__desc { font-size: var(--font-size-caption); color: var(--color-fg-tertiary); margin-bottom: var(--space-5); }
  .cta__actions { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .terminal__tabs { gap: 0; }
    .terminal__tab { padding: var(--space-2) var(--space-2); font-size: 0.65rem; }
    .terminal__body { padding: var(--space-4); }
    .topo__header { flex-direction: column; gap: var(--space-2); }
    .showcase__card { flex: 0 0 280px; }
    .showcase__card--team { flex: 0 0 300px; }
  }
  @media (max-width: 480px) {
    .hero-title { font-size: clamp(1.8rem, 8vw, 2.2rem); }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-cta { justify-content: center; }
    .terminal__tab { padding: var(--space-2); }
    .topo-svg { min-width: 600px; }
  }
</style>

<script>
  /* Tab switching */
  document.querySelectorAll('[role="tablist"]').forEach(tablist => {
    tablist.querySelectorAll('[role="tab"]').forEach(tab => {
      tab.addEventListener('click', () => {
        const platform = (tab as HTMLElement).dataset.platform;
        tablist.querySelectorAll('[role="tab"]').forEach(t => t.setAttribute('aria-selected', 'false'));
        tab.setAttribute('aria-selected', 'true');
        const panelContainer = tablist.closest('.terminal')?.querySelector('.terminal__body');
        if (panelContainer) {
          panelContainer.querySelectorAll('[role="tabpanel"]').forEach(p => (p as HTMLElement).hidden = true);
          const target = panelContainer.querySelector('#term-panel-' + platform);
          if (target) (target as HTMLElement).hidden = false;
        }
      });
    });
  });

  /* Copy buttons */
  document.querySelectorAll('.terminal__copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const cmd = (btn as HTMLElement).dataset.cmd;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
        (btn as HTMLElement).style.color = '#28c840';
        setTimeout(() => {
          btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
          (btn as HTMLElement).style.color = '';
        }, 1500);
      } catch {}
    });
  });

  /* Scroll-driven showcase cards */
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px -40px 0px' });

  document.querySelectorAll('.showcase__card').forEach(card => observer.observe(card));

  /* Showcase arrow navigation */
  (() => {
    const track = document.querySelector<HTMLElement>('.showcase__track');
    const cards = document.querySelectorAll('.showcase__card');
    const prevBtn = document.getElementById('showcase-prev');
    const nextBtn = document.getElementById('showcase-next');
    const dotsContainer = document.getElementById('showcase-dots');
    if (!track || !cards.length || !prevBtn || !nextBtn || !dotsContainer) return;

    const cardCount = cards.length;
    let current = 0;
    let animating = false;

    // Build dots
    for (let i = 0; i < cardCount; i++) {
      const dot = document.createElement('button');
      dot.className = 'showcase__dot' + (i === 0 ? ' showcase__dot--active' : '');
      dot.setAttribute('aria-label', '卡片 ' + (i + 1));
      dot.addEventListener('click', () => scrollToCard(i));
      dotsContainer.appendChild(dot);
    }
    const dots = dotsContainer.querySelectorAll('.showcase__dot');

    function centerOf(idx: number): number {
      const card = cards[idx] as HTMLElement;
      return card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2;
    }

    function scrollToCard(idx: number) {
      // 环绕：首卡向左 → 末卡；末卡向右 → 首卡
      const next = ((idx % cardCount) + cardCount) % cardCount;
      current = next;
      animating = true;
      track.scrollTo({ left: centerOf(next), behavior: 'smooth' });
      updateDots();
      setTimeout(() => { animating = false; }, 500);
    }

    function updateDots() {
      dots.forEach((d, i) => d.classList.toggle('showcase__dot--active', i === current));
    }

    prevBtn.addEventListener('click', () => scrollToCard(current - 1));
    nextBtn.addEventListener('click', () => scrollToCard(current + 1));

    // 手动拖动/触摸滚动时同步指示点
    track.addEventListener('scroll', () => {
      if (animating) return;
      const trackRect = track.getBoundingClientRect();
      const center = trackRect.left + trackRect.width / 2;
      let closest = 0, minDist = Infinity;
      cards.forEach((card, i) => {
        const r = (card as HTMLElement).getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - center);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      if (closest !== current) { current = closest; updateDots(); }
    }, { passive: true });
  })();
</script>
