---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/content.json';
import { SITE } from '../data/site';
import GateLogo from '../components/GateLogo.astro';
import HeroArt from '../components/HeroArt.astro';
import { Icon } from 'astro-icon/components';

const base = '/';
const pageTitle = content.hero.title + ' — ' + content.hero.subtitle;
const install = content.install || {};

/* ---------- Agent tab：一条完整可复制指令 ---------- */
const agentPrompt =
  '帮我安装并启动 men：git clone https://github.com/cgartlab/men.git && cd men && node scripts/install.mjs && npx astro dev --config site/astro.config.mjs';

/* ---------- 手动安装（仓库一键安装脚本）---------- */
const platformTabs = [
  { id: 'agent', label: '面向 Agent' },
  { id: 'bash', label: 'macOS / Linux' },
  { id: 'windows', label: 'Windows' },
];
const manualCmds: Record<string, { label: string; cmd: string }[]> = {
  bash: [
    { label: '一键安装（管道）', cmd: 'bash <(curl -fsSL https://raw.githubusercontent.com/cgartlab/main/install.sh)' },
    { label: '启动预览', cmd: 'cd men && npx astro dev --config site/astro.config.mjs' },
  ],
  windows: [
    { label: '一键安装（管道）', cmd: 'irm https://raw.githubusercontent.com/cgartlab/main/install.ps1 | iex' },
    { label: '启动预览', cmd: 'cd men && npx astro dev --config site/astro.config.mjs' },
  ],
};

/* ---------- 滚动展示：Agent 数据 ---------- */
const showcaseAgents = [
  {
    id: 'men',
    cn: '门',
    role: '编排与路由核心',
    color: '#e85d04',
    icon: 'lucide:door-open',
    desc: '唯一接收用户指令的角色。意图分诊、任务路由、多 Agent 编排、结果汇总。所有指令从这扇门进入。',
    skills: ['意图判定 (IntentGate)', '混合任务拆分', '多 Wave 调度', '结果汇总与去冲突', '事件审计写入'],
    constraint: '本身不执行具体产出，不写代码、不写作、不设计',
  },
  {
    id: 'si',
    cn: '思',
    role: '规划与写作',
    color: '#4a90d9',
    icon: 'lucide:pen-tool',
    desc: '需求访谈式拆解，产出 plan envelope（依赖图 + 并行波次 + 验收标准）。内容写作与知识管理。',
    skills: ['Plan Envelope 产出', '需求访谈拆解', '内容写作 (博客/文档)', '知识库沉淀', '回评子 Agent 产物'],
    constraint: '只规划不执行代码，写作产出需经 chi 验证',
  },
  {
    id: 'ji',
    cn: '记',
    role: '代码与工程',
    color: '#2ea043',
    icon: 'lucide:code-2',
    desc: '按 plan 实现代码，前端开发优先。GitHub 操作、L1 机械验证、目录结构审计。',
    skills: ['前端实现 (HTML/CSS/JS)', 'GitHub PR/Issue 操作', 'L1 验证 (typecheck/lint)', '写作 (技术文档/周报)', '目录结构审计'],
    constraint: '本地 gate 验证通过后才交付，自我审查后再交 chi',
  },
  {
    id: 'chi',
    cn: '持',
    role: '投资评审 / Judge',
    color: '#bf8700',
    icon: 'lucide:scale',
    desc: '双重身份：投资持仓分析 + 独立 Judge。作为 judge 时用 fresh context 机械验证，只信产物不信自述。',
    skills: ['持仓分析与收益计算', '独立 Judge (fresh-context)', '机械验证复核', '质量门禁判定', '投资数据分析'],
    constraint: 'judge spawn 时用全新 context，不复用被验证者的上下文',
  },
  {
    id: 'yi',
    cn: '艺',
    role: '视觉设计',
    color: '#a371f7',
    icon: 'lucide:palette',
    desc: '处理像素与矢量构成的一切影像。设计决策、配色、版式、生图（SenseNova）、审美分析。',
    skills: ['设计决策与 Token 定义', '生图 (SenseNova U1)', '配色与版式', '审美分析', 'Logo 概念'],
    constraint: '生图能力仅 yi 挂载，设计产出需附设计决策说明',
  },
  {
    id: 'xun',
    cn: '寻',
    role: '搜索与研究',
    color: '#8b5cf6',
    icon: 'lucide:search',
    desc: '网络搜索、RSS 聚合、知识库检索、事实核查。只读约束，不修改源数据。',
    skills: ['网页搜索 (Exa)', 'RSS 聚合扫描', '事实核查 (多源交叉)', '知识库检索', '来源验证与可信度评分'],
    constraint: '只读约束，不修改源数据，搜索结果附来源链接',
  },
];

/* ---------- 机制数据 ---------- */
const mechanisms = content.mechanisms || [];
const faq = install.faq || [];
---

<BaseLayout title={pageTitle}>
  <!-- ===== Hero ===== -->
  <header class="hero" aria-labelledby="hero-title">
    <HeroArt />
    <div class="hero-content">
      <div class="hero-logo"><GateLogo size={56} /></div>
      <p class="hero-eyebrow">{content.hero.brandLine}</p>
      <h1 id="hero-title" class="hero-title">推开<em>这扇门</em></h1>
      <p class="hero-desc">{content.hero.subtitle}</p>
      <div class="hero-actions">
        <a href={base + 'docs'} class="hero-cta hero-cta--primary">
          <Icon name="lucide:book-open" width="16" height="16" />阅读文档
        </a>
        <a href="https://github.com/cgartlab/men" class="hero-cta hero-cta--ghost" target="_blank" rel="noopener">
          <Icon name="lucide:github" width="16" height="16" />GitHub
          <Icon name="lucide:arrow-up-right" width="12" height="12" />
        </a>
      </div>
      <div class="hero-version">
        <span class="hero-version-badge">{SITE.version}</span>
        <span>{content.hero.version.topic}</span>
      </div>
    </div>
  </header>

  <!-- ===== 快速开始 ===== -->
  <section class="install" aria-labelledby="install-title">
    <div class="install__header">
      <h2 id="install-title" class="install__title">快速开始</h2>
      <a href={base + 'docs/install'} class="install__guide">完整安装指南 <Icon name="lucide:arrow-right" width="14" height="14" /></a>
    </div>

    <div class="terminal">
      <div class="terminal__chrome">
        <div class="terminal__dots">
          <span class="terminal__dot terminal__dot--red"></span>
          <span class="terminal__dot terminal__dot--yellow"></span>
          <span class="terminal__dot terminal__dot--green"></span>
        </div>
        <div class="terminal__tabs" role="tablist" aria-label="平台选择">
          {platformTabs.map((p, i) => (
            <button class="terminal__tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-platform={p.id}>{p.label}</button>
          ))}
        </div>
      </div>
      <div class="terminal__body">
        <!-- Agent tab -->
        <div class="terminal__panel" id="term-panel-agent" role="tabpanel">
          <p class="terminal__intro">把这句话发给任何 AI 助手（OpenCode / Claude / Cursor），一键复制全文：</p>
          <div class="terminal__cmd">
            <div class="terminal__cmd-line">
              <span class="terminal__ps1 terminal__ps1--agent">{'>'}</span>
              <code>{agentPrompt}</code>
              <button class="terminal__copy" aria-label="复制完整提示词" data-cmd={agentPrompt}>
                <Icon name="lucide:copy" width="14" height="14" />
              </button>
            </div>
          </div>
        </div>
        <!-- macOS / Linux -->
        <div class="terminal__panel" id="term-panel-bash" role="tabpanel" hidden>
          {(manualCmds.bash || []).map((c) => (
            <div class="terminal__cmd">
              <span class="terminal__cmd-label">{c.label}</span>
              <div class="terminal__cmd-line">
                <span class="terminal__ps1">$</span>
                <code>{c.cmd}</code>
                <button class="terminal__copy" aria-label={'复制 ' + c.label} data-cmd={c.cmd}>
                  <Icon name="lucide:copy" width="14" height="14" />
                </button>
              </div>
            </div>
          ))}
        </div>
        <!-- Windows -->
        <div class="terminal__panel" id="term-panel-windows" role="tabpanel" hidden>
          {(manualCmds.windows || []).map((c) => (
            <div class="terminal__cmd">
              <span class="terminal__cmd-label">{c.label}</span>
              <div class="terminal__cmd-line">
                <span class="terminal__ps1">$</span>
                <code>{c.cmd}</code>
                <button class="terminal__copy" aria-label={'复制 ' + c.label} data-cmd={c.cmd}>
                  <Icon name="lucide:copy" width="14" height="14" />
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Agent 滚动展示 ===== -->
  <section class="showcase" aria-labelledby="showcase-title">
    <h2 id="showcase-title" class="sr-only">Agent 团队</h2>
    <div class="showcase__header">
      <p class="showcase__label">THE TEAM</p>
      <h3 class="showcase__heading">六个角色，一个核心</h3>
      <p class="showcase__sub">各司其职，机械验证优先，假完成必识破。</p>
    </div>
    <div class="showcase__track">
      {showcaseAgents.map((a) => (
        <article class="showcase__card" data-agent={a.id} style={`--card-accent: ${a.color}`}>
          <div class="showcase__card-icon">
            <Icon name={a.icon} width="32" height="32" />
          </div>
          <div class="showcase__card-head">
            <span class="showcase__card-cn">{a.cn}</span>
            <span class="showcase__card-id">{a.id}</span>
          </div>
          <p class="showcase__card-role">{a.role}</p>
          <p class="showcase__card-desc">{a.desc}</p>
          <div class="showcase__card-skills">
            {a.skills.map((s) => (
              <span class="showcase__skill">{s}</span>
            ))}
          </div>
          <p class="showcase__card-constraint">
            <Icon name="lucide:shield" width="13" height="13" />
            {a.constraint}
          </p>
        </article>
      ))}
      <!-- 团队特性卡片 -->
      <article class="showcase__card showcase__card--team" style={`--card-accent: #e85d04`}>
        <div class="showcase__card-icon">
          <Icon name="lucide:users" width="32" height="32" />
        </div>
        <p class="showcase__card-role" style="font-size: var(--font-size-h4);">团队特性</p>
        <div class="showcase__team-traits">
          <div class="showcase__trait">
            <Icon name="lucide:git-branch" width="16" height="16" />
            <div>
              <strong>Wave 并行调度</strong>
              <span>无依赖任务同时开工，依赖关系自动保障</span>
            </div>
          </div>
          <div class="showcase__trait">
            <Icon name="lucide:shield-check" width="16" height="16" />
            <div>
              <strong>双层机械验证</strong>
              <span>verify.mjs 五项检查 + chi 独立 Judge 语义复核</span>
            </div>
          </div>
          <div class="showcase__trait">
            <Icon name="lucide:activity" width="16" height="16" />
            <div>
              <strong>全量事件审计</strong>
              <span>events.jsonl 记录 14 种事件，所有决策可追溯</span>
            </div>
          </div>
          <div class="showcase__trait">
            <Icon name="lucide:brain" width="16" height="16" />
            <div>
              <strong>自主学习回路</strong>
              <span>learn.mjs 自动提取经验，eval-metrics 计算 KPI</span>
            </div>
          </div>
          <div class="showcase__trait">
            <Icon name="lucide:lock" width="16" height="16" />
            <div>
              <strong>安全门禁</strong>
              <span>gate.mjs 白名单防注入，上限 5 次防死循环</span>
            </div>
          </div>
          <div class="showcase__trait">
            <Icon name="lucide:file-code" width="16" height="16" />
            <div>
              <strong>零依赖脚本</strong>
              <span>纯 Node 运行，验证/门禁/审计三件套无第三方依赖</span>
            </div>
          </div>
        </div>
      </article>
    </div>
    <div class="showcase__nav">
      <button class="showcase__arrow" id="showcase-prev" aria-label="上一个">
        <Icon name="lucide:chevron-left" width="20" height="20" />
      </button>
      <div class="showcase__dots" id="showcase-dots"></div>
      <button class="showcase__arrow" id="showcase-next" aria-label="下一个">
        <Icon name="lucide:chevron-right" width="20" height="20" />
      </button>
    </div>
  </section>
  <section class="topo" aria-labelledby="topo-title">
    <div class="topo__header">
      <h2 id="topo-title" class="topo__title">团队拓扑</h2>
      <a href={base + 'roles'} class="topo__all">查看全部角色 <Icon name="lucide:arrow-right" width="14" height="14" /></a>
    </div>
    <p class="topo__desc">用户指令 → IntentGate 分诊 → Wave 并发 spawn → verify.mjs 机械门禁 → chi fresh-context 复核 → 四段汇报回传；失败回到失败点重试 ≤5 次</p>

    <div class="topo-diagram">
      <svg viewBox="0 0 1200 560" class="topo-svg" aria-hidden="true">
        <defs>
          <!-- Arrowheads -->
          <marker id="mk-fg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0L10,5L0,10z" fill="#8b949e" /></marker>
          <marker id="mk-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0L10,5L0,10z" fill="#e85d04" /></marker>
          <marker id="mk-green" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0L10,5L0,10z" fill="#2ea043" /></marker>
          <marker id="mk-amber" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0L10,5L0,10z" fill="#bf8700" /></marker>
          <marker id="mk-purple" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0L10,5L0,10z" fill="#8b5cf6" /></marker>

          <!-- Forward paths -->
          <path id="tz-in" d="M200,282 L276,282" />
          <path id="tz-br-1" d="M500,282 C565,282 555,97 616,97" />
          <path id="tz-br-2" d="M500,282 C565,282 555,165 616,165" />
          <path id="tz-br-3" d="M500,282 C565,282 555,233 616,233" />
          <path id="tz-br-4" d="M500,282 C565,282 555,301 616,301" />
          <path id="tz-br-5" d="M500,282 C565,282 555,369 616,369" />

          <!-- Products → mechanical gate -->
          <path id="tz-out-1" d="M750,97 C798,97 786,286 826,286" />
          <path id="tz-out-2" d="M750,165 C796,165 788,286 826,286" />
          <path id="tz-out-3" d="M750,233 C792,233 792,286 826,286" />
          <path id="tz-out-4" d="M750,301 C792,301 792,286 826,286" />
          <path id="tz-out-5" d="M750,369 C798,369 786,286 826,286" />

          <!-- Gate → Judge (all PASS) -->
          <path id="tz-verdict" d="M980,286 L1036,286" />

          <!-- FAIL loops back to dispatch -->
          <path id="tz-fail-1" d="M905,252 C905,44 390,44 390,228" />
          <path id="tz-fail-2" d="M1110,252 C1110,16 390,16 390,228" />

          <!-- REPORT back to user -->
          <path id="tz-report" d="M1110,320 C1110,452 120,452 120,322" />

          <!-- LEARN sink -->
          <path id="tz-learn" d="M650,452 L650,488" />
        </defs>

        <!-- Edges -->
        <use href="#tz-in" class="topo-bezier topo-bezier--input" marker-end="url(#mk-fg)" />
        <use href="#tz-br-1" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-br-2" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-br-3" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-br-4" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-br-5" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-out-1" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-out-2" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-out-3" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-out-4" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-out-5" class="topo-bezier topo-bezier--branch" marker-end="url(#mk-accent)" />
        <use href="#tz-verdict" class="topo-bezier topo-bezier--verdict" marker-end="url(#mk-green)" />
        <use href="#tz-fail-1" class="topo-bezier topo-bezier--fail" marker-end="url(#mk-amber)" />
        <use href="#tz-fail-2" class="topo-bezier topo-bezier--fail" marker-end="url(#mk-amber)" />
        <use href="#tz-report" class="topo-bezier topo-bezier--report" marker-end="url(#mk-green)" />
        <use href="#tz-learn" class="topo-bezier topo-bezier--learn" marker-end="url(#mk-purple)" />

        <!-- Edge labels -->
        <text x="1010" y="274" text-anchor="middle" class="topo-elabel topo-elabel--pass">全 PASS</text>
        <text x="650" y="34" text-anchor="middle" class="topo-elabel topo-elabel--fail">FAIL · LOOP 重试 ≤5 次</text>
        <text x="615" y="442" text-anchor="middle" class="topo-elabel topo-elabel--report">REPORT · 四段结构化汇报</text>

        <!-- Flow dots -->
        <circle r="3.5" class="topo-dot topo-dot--input"><animateMotion dur="2.5s" repeatCount="indefinite"><mpath href="#tz-in" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2s" repeatCount="indefinite"><mpath href="#tz-br-1" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2s" repeatCount="indefinite" begin="0.15s"><mpath href="#tz-br-2" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2s" repeatCount="indefinite" begin="0.3s"><mpath href="#tz-br-3" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2s" repeatCount="indefinite" begin="0.45s"><mpath href="#tz-br-4" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2s" repeatCount="indefinite" begin="0.6s"><mpath href="#tz-br-5" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.4s"><mpath href="#tz-out-1" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.6s"><mpath href="#tz-out-2" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.8s"><mpath href="#tz-out-3" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2.2s" repeatCount="indefinite" begin="1.0s"><mpath href="#tz-out-4" /></animateMotion></circle>
        <circle r="2.8" class="topo-dot"><animateMotion dur="2.2s" repeatCount="indefinite" begin="1.2s"><mpath href="#tz-out-5" /></animateMotion></circle>
        <circle r="3" class="topo-dot topo-dot--verdict"><animateMotion dur="1.6s" repeatCount="indefinite"><mpath href="#tz-verdict" /></animateMotion></circle>
        <circle r="2.6" class="topo-dot topo-dot--fail"><animateMotion dur="3.2s" repeatCount="indefinite"><mpath href="#tz-fail-1" /></animateMotion></circle>
        <circle r="2.6" class="topo-dot topo-dot--fail"><animateMotion dur="3.2s" repeatCount="indefinite" begin="0.8s"><mpath href="#tz-fail-2" /></animateMotion></circle>
        <circle r="3.5" class="topo-dot topo-dot--report"><animateMotion dur="3.5s" repeatCount="indefinite"><mpath href="#tz-report" /></animateMotion></circle>
        <circle r="2.6" class="topo-dot topo-dot--learn"><animateMotion dur="1.8s" repeatCount="indefinite"><mpath href="#tz-learn" /></animateMotion></circle>

        <!-- User -->
        <g>
          <rect x="40" y="250" width="160" height="64" class="topo-node topo-node--input" />
          <text x="120" y="278" text-anchor="middle" class="topo-label topo-label--input">用户</text>
          <text x="120" y="298" text-anchor="middle" class="topo-label topo-label--sub">自然语言指令</text>
        </g>

        <!-- men hub -->
        <g>
          <rect x="280" y="232" width="220" height="100" rx="16" class="topo-node topo-node--hub" />
          <text x="390" y="268" text-anchor="middle" class="topo-label topo-label--hub-cn">men 门</text>
          <text x="390" y="292" text-anchor="middle" class="topo-label topo-label--hub-sub">IntentGate · 唯一 spawner</text>
          <text x="390" y="312" text-anchor="middle" class="topo-label topo-label--hub-sub2">Wave ≤4 并行 · COLLECT</text>
          <rect x="280" y="232" width="220" height="100" rx="16" class="topo-pulse" />
        </g>

        <!-- Agents column -->
        <g>
          <rect x="620" y="70" width="130" height="54" class="topo-node topo-node--agent" />
          <text x="668" y="94" text-anchor="middle" class="topo-label topo-label--agent-cn">思</text>
          <text x="668" y="112" text-anchor="middle" class="topo-label topo-label--agent-id">si · 规划写作</text>
          <circle cx="740" cy="78" r="4" class="topo-status topo-status--active" />
        </g>
        <g>
