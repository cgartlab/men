---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/content.json';
import { Icon } from 'astro-icon/components';

const base = '/';
const pageTitle = '团队角色 — ' + content.hero.title;
const pageDesc = 'men（门）六个 Agent 角色详解：各自的定位、职责边界与交付物，以及一个请求如何在 men 编排下被路由到合适的子角色。';
const roles = content.roles;

// Enhanced role details for agent cards
const roleDetails: Record<string, {
  responsibilities: string[];
  skills: string[];
  input: string;
  output: string;
  redlines: string[];
  charter: string;
}> = {
  men: {
    responsibilities: [
      '接到你的指令，判断该谁做',
      '派活给合适的人，能同时派的就同时派',
      '收齐结果，整理成报告交给你',
      '干完自动记经验，下次更聪明',
    ],
    skills: ['si-plan-compose（规划拆解）', 'chi-judge（独立评审）'],
    input: '你的一句话指令',
    output: '一份报告：做了什么、要点、来源、需要你定的问题',
    redlines: ['不写代码、不写文章、不做设计', '拿不准就先问你，不猜', '最多重试 5 次，不行就老实说卡住了'],
    charter: '追问到清楚为止，不猜',
  },
  si: {
    responsibilities: [
      '把大任务拆成小任务，标好依赖关系',
      '给每个小任务写"做成什么样算完"',
      '管理知识库，记下踩过的坑',
      '评估别人的产出，只评不改',
    ],
    skills: ['si-plan-compose（方案拆解）', 'si-knowledge（知识管理）'],
    input: '门分派的子任务描述和上下文',
    output: '任务拆解方案 / 知识沉淀文档 / 回评报告',
    redlines: ['只评不改——看别人产出时只标注不改写', '不直接写代码或生图'],
    charter: '想清楚再动手',
  },
  ji: {
    responsibilities: [
      '写代码（前端优先）',
      '管 GitHub——PR、Review、Issue',
      '写文章、文档、周报',
      '代码写完跑 typecheck/lint/test，过了才交',
    ],
    skills: ['ji-frontend-design（前端实现）', 'ji-github（GitHub 操作）', 'ji-content-write（内容写作）', 'ji-l1-verify（机械验证）'],
    input: '拆解方案里分到的子任务和代码规范',
    output: '代码文件 / PR / Markdown 文档',
    redlines: ['先验证再交——typecheck/lint/test 全过才行', '不编"我做完了"——必须有实际文件'],
    charter: '实现阶段可自主决策，遇到歧义回头问门',
  },
  chi: {
    responsibilities: [
      '做投资分析——持仓、收益、市场数据',
      '当质检员——用全新视角审核别人的产出',
      '只看实际文件，不听口头汇报',
      '脚本查完它再查一遍',
    ],
    skills: ['chi-invest（投资分析）', 'chi-judge（独立评审）'],
    input: '别人交上来的文件路径和验收标准',
    output: '评审结论（通过/不通过 + 具体问题清单）',
    redlines: ['只信实物——"我完成了"不算完成证据', '独立判断——不继承被审核者的上下文'],
    charter: '按验收标准机械判定',
  },
  yi: {
    responsibilities: [
      '做设计决策——配色、字体、间距、布局',
      '生成配图和插画',
      '维护设计令牌体系',
      '查无障碍对比度',
    ],
    skills: ['yi-design（设计决策）', 'yi-imagegen（图像生成）'],
    input: '设计需求和品牌约束',
    output: '设计稿 / 生图文件 / 配色方案',
    redlines: ['生图能力只有艺有——别人没法直接出图', '对比度要达标——小字 4.5:1，大字 3:1'],
    charter: '设计需求追问到清楚——风格、调性、用途',
  },
  xun: {
    responsibilities: [
      '搜网页、查资料',
      '扫 RSS 订阅源',
      '交叉核实信息真假',
      '每条信息都标来源',
    ],
    skills: ['xun-search（网页搜索）', 'xun-rss-scan（RSS 扫描）', 'xun-factcheck（事实核查）'],
    input: '搜索关键词或事实核查请求',
    output: '事实清单 / 调研报告（每条带来源链接）',
    redlines: ['只查不改——不修改源数据', '无来源 = 无效', '搜不到就老实说搜不到'],
    charter: '搜索范围可以自己扩，关键事实要交叉验证',
  },
};

// Flow states: sample task "写一份行业研究报告"
const flowSteps = [
  {
    id: 'input',
    icon: 'lucide:message-square',
    label: '你说一句话',
    example: '"写一份 2026 年 AI Agent 行业研究报告"',
    detail: '你用大白话说出想做什么。不用指定谁来做。',
  },
  {
    id: 'receive',
    icon: 'lucide:door-open',
    label: '门接住，记下编号',
    example: '生成任务档案',
    detail: '门把你的话记下来，给任务编个号。后面每一步都查得到。',
  },
  {
    id: 'triage',
    icon: 'lucide:git-branch',
    label: '判断该派谁',
    example: '判定：需要多角色配合',
    detail: '门翻一遍过去的经验，判断这个活儿需要哪几个人配合。拿不准就先问你。',
  },
  {
    id: 'plan',
    icon: 'lucide:file-text',
    label: '思拆任务',
    example: '拆成 5 个小任务，标好先后',
    detail: '思把大活儿拆成小活儿，标清哪些能同时做、哪些有先后，每个小活儿都写好"做成什么样算完"。',
  },
  {
    id: 'dispatch',
    icon: 'lucide:zap',
    label: '同时开工',
    example: '寻查数据，艺做配图，同时跑',
    detail: '没有依赖关系的小活儿同时开工，最多 4 个一起跑。',
  },
  {
    id: 'execute',
    icon: 'lucide:play',
    label: '各干各的',
    example: '寻搜数据 / 艺出图 / 思写正文',
    detail: '每个人只干自己擅长的。寻查资料，艺做图，思写内容。互不干扰。',
  },
  {
    id: 'verify',
    icon: 'lucide:shield-check',
    label: '查收成果',
    example: '脚本检查 → 持独立审核',
    detail: '先跑脚本查文件在不在、内容全不全。过了这关，持再看一遍——只看实际文件，不听口头汇报。',
  },
  {
    id: 'report',
    icon: 'lucide:bar-chart-3',
    label: '交报告给你',
    example: '结论 → 要点 → 来源 → 待定问题',
    detail: '门把结果整理成一份报告：做了什么、要点、信息来源、还需要你拍板的问题。',
  },
];

// Routing table data
const routingRows = [
  { keyword: '查信息、查新闻、做调研', target: 'xun（寻）', path: '寻搜一遍，交叉核实', verify: '查来源、交叉核实', output: '一份调研报告（带来源链接）' },
  { keyword: '写代码、改 bug、管 GitHub', target: 'ji（记）', path: '记写代码 + 跑验证', verify: 'typecheck / lint / test', output: '代码文件 / PR / Issue' },
  { keyword: '写文章、写文档、写周报', target: 'ji（记）', path: '记写内容', verify: '查结构、查字数', output: 'Markdown 文章 / 文档' },
  { keyword: '做规划、理思路、管知识', target: 'si（思）', path: '思想清楚 + 拆解', verify: '持按验收标准查', output: '任务拆解方案 / 知识文档' },
  { keyword: '查持仓、算收益、做投资分析', target: 'chi（持）', path: '持做投资分析', verify: '数据来源交叉核实', output: '持仓分析 / 投资建议' },
  { keyword: '做配图、配色、生图', target: 'yi（艺）', path: '艺出图 + 查对比度', verify: '对比度检查', output: '设计稿 / 生图 / 配色方案' },
  { keyword: '做评估、做诊断、做评审', target: 'chi（持）', path: '专家做 + 持审核', verify: '持独立审核', output: '评审报告 / 诊断结论' },
  { keyword: '多件事混在一起、说不清该归谁', target: 'men → 多路并行', path: '门拆分后同时派', verify: '每个子任务各查各的', output: '汇总报告' },
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="roles-page" aria-labelledby="page-title">

    <header class="roles-header">
      <h1 id="page-title" class="roles-title">
        团队角色
      </h1>
      <p class="roles-subtitle">
        你只管说一句话——分工、干活、检查、交报告，团队全自动。下面用一个真实例子带你走一遍。
      </p>
    </header>

    <!-- ======== SECTION 1: Task Flow with Scroll Animation ======== -->
    <section class="flow-section" aria-labelledby="flow-title">
      <h2 id="flow-title" class="section-title">
        <span class="section-num">01</span>
        任务分诊流程
      </h2>
      <p class="section-desc">示例任务：「写一份 2026 年 AI Agent 行业研究报告」</p>

      <div class="flow-timeline">
        <div class="flow-timeline__line" aria-hidden="true"></div>
        <div class="flow-timeline__cursor" aria-hidden="true"></div>

        {flowSteps.map((step, i) => (
          <div class="flow-step" data-step={step.id} data-index={String(i)}>
            <div class="flow-step__marker" aria-hidden="true">
              <div class="flow-step__dot"></div>
              <span class="flow-step__icon"><Icon name={step.icon} width="20" height="20" /></span>
            </div>
            <div class="flow-step__content">
              <div class="flow-step__header">
                <span class="flow-step__num">{'0' + (i + 1)}</span>
                <h3 class="flow-step__label">{step.label}</h3>
              </div>
              <div class="flow-step__example">
                <span class="flow-step__example-tag">示例</span>
                <code>{step.example}</code>
              </div>
              <p class="flow-step__detail">{step.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ======== SECTION 2: Routing Table ======== -->
    <section class="routing-section" aria-labelledby="routing-title">
      <h2 id="routing-title" class="section-title">
        <span class="section-num">02</span>
        路由判定表
      </h2>
      <p class="section-desc">关键词判定 + 意图门分类，低置信时向用户确认，不猜</p>

      <div class="routing-table-wrap">
        <table class="routing-table">
          <thead>
            <tr>
              <th>你说了什么</th>
              <th>谁来做</th>
              <th>怎么做</th>
              <th>怎么查</th>
              <th>你会收到什么</th>
            </tr>
          </thead>
          <tbody>
            {routingRows.map((row) => (
              <tr>
                <td class="routing-table__keyword">{row.keyword}</td>
                <td class="routing-table__target">{row.target}</td>
                <td>{row.path}</td>
                <td class="routing-table__verify">{row.verify}</td>
                <td class="routing-table__output">{row.output}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ======== SECTION 3: Agent Cards with Scroll ======== -->
    <section class="agents-section" aria-labelledby="agents-title">
      <h2 id="agents-title" class="section-title">
        <span class="section-num">03</span>
        6 个 Agent 详解
      </h2>
      <p class="section-desc">滚动查看每个角色的职责、技能、输入输出与约束</p>

      <div class="agents-stage">
        {roles.map((role, i) => {
          const detail = roleDetails[role.name];
          return (
            <article
              id={'agent-' + role.name}
              class="agent-card"
              data-index={String(i)}
              style={'--delay: ' + (i * 0.12) + 's'}
            >
              <div class="agent-card__inner">
              <div class="agent-card__left">
                <span class="agent-card__icon" aria-hidden="true"><Icon name={role.name === 'men' ? 'lucide:door-open' : role.name === 'si' ? 'lucide:brain' : role.name === 'ji' ? 'lucide:code' : role.name === 'chi' ? 'lucide:shield-check' : role.name === 'yi' ? 'lucide:palette' : 'lucide:search'} width="24" height="24" /></span>
                <span class="agent-card__num">{'0' + (i + 1)}</span>
              </div>
                <div class="agent-card__body">
                  <div class="agent-card__header">
                    <h3 class="agent-card__name">{role.cn}</h3>
                    <code class="agent-card__id">{role.name}</code>
                    <span class="agent-card__badge">{role.mode}</span>
                  </div>
                  <p class="agent-card__desc">{role.desc}</p>

                  {detail && (
                    <div class="agent-card__detail">
                      <div class="agent-card__section">
                        <h4 class="agent-card__section-title">职责</h4>
                        <ul class="agent-card__list">
                          {detail.responsibilities.map((r) => (
                            <li>{r}</li>
                          ))}
                        </ul>
                      </div>

                      <div class="agent-card__row">
                        <div class="agent-card__section">
                          <h4 class="agent-card__section-title">技能</h4>
                          <div class="agent-card__tags">
                            {detail.skills.map((s) => (
                              <span class="agent-card__tag">{s}</span>
                            ))}
                          </div>
                        </div>
                        <div class="agent-card__section">
                          <h4 class="agent-card__section-title">约束</h4>
                          <ul class="agent-card__list agent-card__list--compact">
                            {detail.redlines.map((r) => (
                              <li>{r}</li>
                            ))}
                          </ul>
                        </div>
                      </div>

                      <div class="agent-card__row">
                        <div class="agent-card__section">
                          <h4 class="agent-card__section-title">输入</h4>
                          <p class="agent-card__io">{detail.input}</p>
                        </div>
                        <div class="agent-card__section">
                          <h4 class="agent-card__section-title">输出</h4>
                          <p class="agent-card__io">{detail.output}</p>
                        </div>
                      </div>

                      <div class="agent-card__charter" style="display:none;">
                        <span class="agent-card__charter-label">角色性格</span>
                        {detail.charter}
                      </div>
                    </div>
                  )}

                  <div class="agent-card__meta">
                    <span class="agent-card__source">来源: {role.source}</span>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ======== SECTION 4: Intent ======== -->
    <section class="intent-section" aria-labelledby="intent-title">
      <h2 id="intent-title" class="section-title">
        <span class="section-num">04</span>
        四种任务类型
      </h2>
      <div class="intent-text">
        <p>
          门接到你的话后，会归到下面四类里的一类。拿不准归哪类时，门会先问你：
        </p>
        <div class="intent-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin:1.5rem 0;">
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>查信息</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">你说"最近有什么新闻" → 派寻去搜</p>
          </div>
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>做分析</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">你说"这份投资合理吗" → 派持去分析和审核</p>
          </div>
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>多角色配合</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">你说"写一篇行业报告" → 派多个人同时干</p>
          </div>
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>从零规划</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">你说"帮我启动新项目" → 派思想清楚再拆解</p>
          </div>
        </div>
        <p class="intent-link">
          想看完整的路由规则？→ <a href={base + 'docs/agents'}>角色说明文档</a>
        </p>
      </div>
    </section>

    <!-- ======== SECTION 5: Principles ======== -->
    <section class="principles-section" aria-labelledby="principles-title">
      <h2 id="principles-title" class="section-title">
        <span class="section-num">05</span>
        四条底线
      </h2>
      <div class="principles-text">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin:1.5rem 0;">
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>机器说了算</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">脚本说通过才算通过——像考试用答题卡判分，不看你自己写的"我觉得对了"。</p>
          </div>
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>只看实物</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">持只看实际文件——像老师只看卷面答案，不看你说的"我会了"。</p>
          </div>
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>全程留痕</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">每一步都记在案——像快递追踪，随时查到包裹到哪了。</p>
          </div>
          <div style="padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:0.5rem;">
            <strong>不会就停</strong>
            <p style="margin:0.5rem 0 0;font-size:0.9rem;">试 5 次不行就老实说卡住了——不假装能继续，把做完的部分交给你。</p>
          </div>
        </div>
        <p class="principles-link">
          完整红线 → <a href={base + 'docs/governance'}>治理文档</a>
        </p>
      </div>
    </section>

    <section class="roles-nav">
      <a href={base + 'mechanisms'} class="roles-nav__link">
        下一步 → 机制 <span>运行手册 · 验证体系 · 事件系统</span>
      </a>
    </section>
  </section>
</BaseLayout>

<script>
  // Scroll-triggered flow animation
  function initFlowAnimation() {
    const steps = document.querySelectorAll('.flow-step');
    const cursor = document.querySelector('.flow-timeline__cursor');
    if (!steps.length || !cursor) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            // Move cursor to this step
            const dot = entry.target.querySelector('.flow-step__dot');
            if (dot) {
              const rect = dot.getBoundingClientRect();
              const lineRect = document.querySelector('.flow-timeline__line')?.getBoundingClientRect();
              if (lineRect) {
                const top = rect.top - lineRect.top + rect.height / 2;
                (cursor as HTMLElement).style.top = top + 'px';
              }
            }
          } else {
            entry.target.classList.remove('is-active');
          }
        });
      },
      { threshold: 0.5, rootMargin: '-10% 0px -30% 0px' }
    );

    steps.forEach((step) => observer.observe(step));
  }

  // Scroll-triggered agent cards: slide in one by one
  function initAgentAnimation() {
    const cards = document.querySelectorAll('.agent-card');
    if (!cards.length) return;

    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      },
      { threshold: 0.15, rootMargin: '-5% 0px -5% 0px' }
    );

    cards.forEach((card) => cardObserver.observe(card));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initFlowAnimation();
    initAgentAnimation();
  });
</script>

<style>
  /* ===== Page Layout ===== */
  .roles-page {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-4) var(--container-padding-x) var(--space-16);
    position: relative;
    z-index: 1;
  }

  .roles-header {
    padding: var(--space-8) 0 var(--space-6);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: var(--space-12);
  }
  .roles-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: var(--font-weight-semi);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-fg);
    margin-bottom: var(--space-3);
  }
