---
import '../styles/global.css';
import BackgroundCanvas from '../components/BackgroundCanvas.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import content from '../data/content.json';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Men（门）Agent 团队 — 围绕一人内容创作与工程协作的 6+1 Agent 团队系统' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f5" />

    <!-- 外部字体预连接：OPPO Sans woff2 由 code.oppo.com 提供，每个约 744KB。
         preconnect 提前建立 DNS+TCP+TLS，preload 提升 Regular（正文 LCP 候选）优先级。
         Medium 字重不 preload —— 两者共享同一连接，CSS 解析后即可在既有连接上取回。 -->
    <link rel="preconnect" href="https://code.oppo.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://code.oppo.com/content/dam/oppo/common/fonts/font2/new-font/OPPOSansOS2-5000-Regular.woff2"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳至主内容</a>

    <!-- 全局背景动画（Layer A 静态点阵 + Layer B 60s 漂移） -->
    <BackgroundCanvas />

    <!-- 左侧栏竖排小字 -->
    <div class="side-rail side-rail--left" aria-hidden="true">
      <span class="side-rail__text">Men · {SITE.version} · cgartlab</span>
    </div>

    <!-- 右侧栏竖排小字 -->
    <div class="side-rail side-rail--right" aria-hidden="true">
      <span class="side-rail__text">gate · triage · verify · audit</span>
    </div>

    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      // 代码块复制按钮（.code-block 的 pre .copy-btn 由构建期 scripts/highlight-code.mjs 注入）
      document.querySelectorAll('pre .copy-btn').forEach((btn) => {
        const label = btn.getAttribute('aria-label') || '复制代码';
        const ICON = btn.innerHTML;
        btn.addEventListener('click', async () => {
          const pre = btn.closest('pre');
          const code = pre ? pre.textContent.replace(/\n$/, '') : '';
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code);
            btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
            btn.classList.add('copied');
            btn.setAttribute('aria-label', '已复制');
            setTimeout(() => { btn.innerHTML = ICON; btn.classList.remove('copied'); btn.setAttribute('aria-label', label); }, 1500);
          } catch {
            btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>';
            btn.setAttribute('aria-label', '复制失败：请手动选中并复制');
            setTimeout(() => { btn.innerHTML = ICON; btn.setAttribute('aria-label', label); }, 1800);
          }
        });
      });
    </script>

    <script>
      // 固定页头高度 → CSS 变量 --header-h（正文用它下移，避免被页头压住）
      const headerEl = document.querySelector('.site-header');
      const syncHeaderH = () => {
        if (!headerEl) return;
        const h = Math.round(headerEl.getBoundingClientRect().height);
        if (h > 0) document.documentElement.style.setProperty('--header-h', h + 'px');
      };
      syncHeaderH();
      window.addEventListener('resize', syncHeaderH, { passive: true });
      window.addEventListener('orientationchange', syncHeaderH, { passive: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncHeaderH);

      // 导航滚动隐藏
      const header = headerEl;
      if (header) {
        let lastY = window.scrollY;
        let ticking = false;

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const currentY = window.scrollY;
              if (currentY > lastY && currentY > 80) {
                header.classList.add('is-hidden');
              } else {
                header.classList.remove('is-hidden');
              }
              lastY = currentY;
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    /* 原来用 top: -40px 隐藏，而它本身高 42px → 底边 2px 会探进视口，
       在左上角露出一条橘色横线（accent-fill）。改用 transform 按自身高度移出，
       不论高度怎么变都不会露边。 */
    top: var(--space-4);
    transform: translateY(-300%);
    left: var(--space-4);
    /* 实心填充 + 白字令牌（4.80:1） */
    background: var(--color-accent-fill);
    color: var(--color-on-accent-fill);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-caption);
    z-index: 100;
    transition: transform var(--duration-normal) ease;
  }

  .skip-link:focus {
    transform: translateY(0);
    outline: none;
    text-decoration: none;
  }

  main {
    max-width: var(--container-max);
    margin: 0 auto;
    /* 页头是 position: fixed → 正文顶部必须按它的**实测**高度下移（--header-h 由脚本写入），
       否则窄屏两行页头（≈89px）会把页面标题压在下面。原来写死 48/32px 正是这个 bug 的来源。 */
    padding: var(--header-h, 84px) var(--container-padding-x) var(--space-16);
    position: relative;
    z-index: 1;
  }

  @media (max-width: 768px) {
    main {
      padding: var(--header-h, 84px) var(--space-6) var(--space-12);
    }
  }
</style>
